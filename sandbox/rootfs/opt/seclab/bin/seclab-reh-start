#!/bin/sh
# seclab-reh-start: start this tab's REH once (idempotent). Runs INSIDE the tab as the
# tab user, invoked by seclab-tabd with a fixed argv. The connection token arrives on
# stdin, never argv. Listens on a Unix socket only: no TCP port, nothing published.
set -eu
umask 077

RUN="/run/user/$(id -u)/seclab"
mkdir -p "$RUN"
chmod 700 "$RUN"

IFS= read -r TOKEN || true
case "$TOKEN" in
	""|*[!0-9a-f]*) echo "seclab-reh-start: invalid token" >&2; exit 2 ;;
esac
[ "${#TOKEN}" -eq 64 ] || { echo "seclab-reh-start: invalid token length" >&2; exit 2; }

if [ -S "$RUN/reh.sock" ] && [ -f "$RUN/reh.pid" ] && kill -0 "$(cat "$RUN/reh.pid")" 2>/dev/null; then
	if [ "$(cat "$RUN/token")" = "$TOKEN" ]; then
		exit 0
	fi
	kill "$(cat "$RUN/reh.pid")" 2>/dev/null || true
	sleep 1
fi

printf '%s' "$TOKEN" > "$RUN/token"
rm -f "$RUN/reh.sock"

# Everything the REH runs (extensions, tasks, terminals, LSPs, git) inherits this clean
# environment. The runtime may inject proxy variables (sbx sets lowercase http(s)_proxy to
# its own proxy); both cases are overridden so its values never win. Until the broker
# lands (M2) egress points at a blackhole; the fence denies everything else anyway.
PROXY="http://127.0.0.1:9"
setsid env -i \
	HOME="$HOME" USER="$(id -un)" LOGNAME="$(id -un)" SHELL=/bin/bash LANG=C.UTF-8 \
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
	XDG_RUNTIME_DIR="/run/user/$(id -u)" \
	HTTP_PROXY="$PROXY" HTTPS_PROXY="$PROXY" http_proxy="$PROXY" https_proxy="$PROXY" \
	ALL_PROXY="$PROXY" all_proxy="$PROXY" NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 \
	SECLAB_TAB=1 \
	/opt/seclab-reh/bin/seclab-code-server \
		--socket-path "$RUN/reh.sock" \
		--connection-token-file "$RUN/token" \
		--disable-telemetry \
		</dev/null >"$RUN/reh.log" 2>&1 &
echo $! > "$RUN/reh.pid"

i=0
while [ $i -lt 150 ]; do
	[ -S "$RUN/reh.sock" ] && exit 0
	kill -0 "$(cat "$RUN/reh.pid")" 2>/dev/null || break
	sleep 0.2
	i=$((i + 1))
done
echo "seclab-reh-start: REH did not come up" >&2
tail -n 20 "$RUN/reh.log" >&2 || true
exit 1
