#!/bin/sh
# seclab-tab-env: run a command with the clean tab environment. Everything the REH
# starts (extensions, tasks, terminals, LSPs, git) inherits exactly this environment;
# the containment suite uses it to trigger workspace vectors the same way.
# The runtime may inject proxy variables (sbx sets lowercase http(s)_proxy to its own
# proxy); both cases are overridden so its values never win. Egress goes to the tab's broker
# when tabd configured one (plan tabd-broker-wiring B1): it writes the proxy URL and the
# broker CA into the root-owned /run/seclab-broker before the REH starts. Without a broker,
# egress points at a blackhole; the fence denies everything else anyway.
PROXY="http://127.0.0.1:9"
B=/run/seclab-broker
CA=""
if [ -r "$B/proxy-url" ] && [ -r "$B/ca.pem" ] && [ -r "$B/bundle.pem" ]; then
	url="$(head -c 512 "$B/proxy-url" | head -n 1)"
	case "$url" in
		http://*[!A-Za-z0-9_:@./-]*) ;; # unexpected characters: keep the blackhole
		http://*@*:[0-9]*) PROXY="$url"; CA=1 ;;
	esac
fi
U="$(id -un 2>/dev/null || echo agent)" # OCI on native Linux runs as the workspace owner's uid (no passwd entry)
if [ -n "$CA" ]; then
	set -- env NODE_EXTRA_CA_CERTS="$B/ca.pem" SSL_CERT_FILE="$B/bundle.pem" REQUESTS_CA_BUNDLE="$B/bundle.pem" \
		CURL_CA_BUNDLE="$B/bundle.pem" GIT_SSL_CAINFO="$B/bundle.pem" "$@"
	# CFS package feeds (ADR cfs-package-feeds-in-tabs), when the user enabled them for this tab:
	# tabd writes npm's config, its registry and pip's index URL here with the broker's sentinel
	# (never the token). The feed paths come from the host's CFS config, so here they are checked
	# for shape only: the fixed host, the feed path layout, nothing else (review EEE-5). The
	# registry in env outranks a workspace .npmrc. Anything unexpected: no feeds.
	if [ -r "$B/npmrc" ] && [ -r "$B/pip-index-url" ] && [ -r "$B/npm-registry" ]; then
		pip="$(head -c 600 "$B/pip-index-url" | head -n 1)"
		reg="$(head -c 400 "$B/npm-registry" | head -n 1)"
		# https://cfs:<sentinel>@pkgs.dev.azure.com/<org>/<project>/_packaging/<feed>/pypi/simple/:
		# the password part is cut out and checked on its own, then the rest.
		pw="${pip#https://cfs:}"; pw="${pw%%@*}"
		case "$pw" in
			seclab_cfs_*) case "$pw" in *[!A-Za-z0-9_-]*) pip="" ;; esac ;;
			*) pip="" ;;
		esac
		pp="${pip#https://cfs:$pw@pkgs.dev.azure.com}"
		[ "$pp" != "$pip" ] || pip=""
		case "$pp$reg" in *[!A-Za-z0-9._/:-]*|*/./*|*/../*) pip="" ;; esac
		case "$pp" in /?*/?*/_packaging/?*/pypi/simple/) ;; *) pip="" ;; esac
		case "$reg" in https://pkgs.dev.azure.com/?*/?*/_packaging/?*/npm/registry/) ;; *) pip="" ;; esac
		if [ -n "$pip" ]; then
			set -- env NPM_CONFIG_GLOBALCONFIG="$B/npmrc" NPM_CONFIG_REGISTRY="$reg" PIP_INDEX_URL="$pip" "$@"
		fi
	fi
fi
exec env -i \
	HOME="${HOME:-/home/$U}" USER="$U" LOGNAME="$U" SHELL=/bin/bash LANG=C.UTF-8 \
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/seclab-reh/bin/remote-cli \
	XDG_RUNTIME_DIR="/run/user/$(id -u)" \
	HTTP_PROXY="$PROXY" HTTPS_PROXY="$PROXY" http_proxy="$PROXY" https_proxy="$PROXY" \
	ALL_PROXY="$PROXY" all_proxy="$PROXY" NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 \
	SECLAB_TAB=1 \
	"$@"
