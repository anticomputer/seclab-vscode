# Placeholder for the per-tab broker sidecar (M2 replaces it with the mitmproxy broker
# from the broker session). It holds the sidecar slot on the tab's --internal network and
# answers the stdio control channel (`docker exec -i <tab>-broker seclab-broker-control`)
# with a fixed "placeholder" reply so the control path is exercised end to end.
FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
COPY seclab-broker-control /usr/local/bin/seclab-broker-control
RUN chmod 0755 /usr/local/bin/seclab-broker-control
USER 65534:65534
CMD ["sleep", "infinity"]
