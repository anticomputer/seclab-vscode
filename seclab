#!/usr/bin/env bash
# seclab: one entry point for the build and dev loop. Runs only docker/sbx/gh on the
# host; all toolchains live in containers or on GitHub Actions.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT="$ROOT/.work/out"

usage() {
	cat <<'EOF'
usage: ./seclab <command>
  build linux [reh|editor ...]  Build Linux REH (default) and/or editor in containers -> .work/out/
                                (SECLAB_BUILD_VOLUME=seclab-<name>: a separate builder volume for experiments)
                                (editor needs >= 12 GB Docker memory: esbuild peaks ~5 GB RSS)
  template sbx                  Build the sbx tab template (shell kit + REH) -> seclab-tab:local
  image oci [--test-variant V]  Build the OCI tab images (seclab-tab-oci:local, broker placeholder);
                                with --test-variant, only seclab-tab-oci:test-V from that variant's REH
  test unit                     seclab-tabd unit tests (in a node container)
  test e2e [sbx|oci]            seclab-tabd end-to-end against a real runtime (local)
  test e2e-broker [oci|sbx] [IMAGE]
                                A tab with a real broker: deny, no direct route, allow, 407 (B1 OCI, B2 sbx)
  test containment [sbx|oci]    Containment suite: malicious-workspace vectors inside real tabs
  test canary [sbx|oci]         Canary acceptance test: no host secret observable from a tab
  test secrets [sbx|oci]        Pre-mount secret scan (gitleaks) gate, move-to-vault, restore
  test obs [sbx|oci]            Tab observability: inert loader -> expected events and labels; sensor tampering -> gap
  test probes                   AHP probes against the real upstream client (no window, no network): each must land where it claims
  test builds                   Test build variants: the harness's hook check (require-hooks) self-test
  tab logs [-f] [--format text|json|falco] [--min PRIORITY] [--state-dir DIR] <tabId|all>
                                Read a tab's observability log (default: the editor's state dir)
  test evidence prepare|check DIR [sbx|oci]
                                Editor-driven run (rogue extension, editor-side canaries)
  lint fixtures [PATH...]       Fixture-safety lint (no real secrets/hosts/persistence in test payloads)
  lint source                   Shipped sources: no unreviewed env/spawn sites, no dynamic loading, no test markers
  lint mounts                   Single-file container mounts (deps outdated, image verify) cover their imports
  lint deps [--self-test]       Dependency register: every pin in deps/registry.json, entries complete (ADR)
  lint pin-age [--days N] [--verbose]
                                No register pin younger than 7 days (the feed's hold; EDR pin-age-cooldown). Network
  lint secrets [BASE]           gitleaks (built from pinned source) over git diff BASE..HEAD (default: merge base
                                with origin/main); also run by CI (lint) and the pre-push hook
  hooks install                 Use the repo's git hooks (build/hooks: pre-push runs lint secrets and the
                                publish gate) in this clone; refused until main carries the gate. The hook
                                directory is left read-only so an older installer can't downgrade it
  hooks check                   Exit 1 unless the active hook is the locked gate hook the installer wrote
  lint publish [--self-test|--mount-test]
                                Publish gate over HEAD's tree: only what can be shown to be public (EDR);
                                --mount-test: a fake mode-600 list through the real container mount
  scan-text                     The publish gate over stdin: run it on any text before posting it with gh
  deps outdated                 Report image tags that moved and tracked tools with newer releases
  cfs config | check | --self-test
                                The host-side CFS feed config (outside the repo; the tree has example values):
                                write it from gh cfs (host: gh, az, pip3), validate it, or run the shared vectors
  liveness --self-test | check | verify-runs | marks FILE.yml#JOB LOG
                                Everything that only matters if something runs it names what runs it,
                                with evidence it ran (build/liveness/register.json)
  tool NAME                     Verify and build a pinned tool image (cosign, actionlint, gitleaks, lychee;
                                build/tools/tools.json); prints its local tag
  deps host                     Check the host prerequisites (recorded exception, EDR supply-chain-exceptions):
                                gh is byte-identical to cli/cli's attested release; Docker Desktop and sbx
                                carry Docker, Inc.'s Developer ID signature (macOS). Read-only.
  docs write                    Regenerate the ADR/EDR/security-review indexes, FINDINGS.md and docs/DEPENDENCIES.md
  docs check [--run-commands] [--online] [--paired]
                                Docs drift gate: records, generated indexes, links, permalinks, ARCHITECTURE
                                consistency, the security findings register; --run-commands runs <!-- ci: run -->
                                blocks (and the broker's); --online resolves external links (lychee, cached);
                                --paired enforces doc changes next to protocol/patch/provider/product changes
  findings --self-test | check | baseline | rot | remap --branch B
                                Security findings register (docs/security-reviews/findings.json): every review
                                finding registered, fixed ones with a regression test, no open high outside the
                                shrinking baseline; `baseline` prints the open highs (markdown)
  fetch macos [RUN_ID]          Download the unsigned macOS app from Actions -> .work/app/
  fetch macos-branch RUN_ID     A dispatched non-main test build (attestation checked against its
                                branch) -> .work/app-branch/ (never the release location)
  fetch macos-VARIANT RUN_ID    A test build variant (test/builds/variants.json, e.g. macos-containment):
                                the renamed app + hooked REH, attested -> .work/test-builds/VARIANT/
                                (UNSAFE, never a release; check-release refuses it)
  clean-host [--apply] [--running] [--caches]
                                List (dry run) or remove every seclab resource on this host: sandboxes,
                                containers, networks, volumes, test profiles, stray test editors/tabd.
                                Never touches other sandboxes (e.g. copilot-*)
  help                          This text
EOF
}

ZIZMOR_IMAGE="ghcr.io/zizmorcore/zizmor:1.31.1@sha256:42d409dbb851d4c5d35a058cf042b828bea1e3f2884378c526eb0974780e18d9"
# Tools pinned in build/tools/tools.json, verified and built locally (EDR 20261105-pinned-tools):
# cosign and actionlint are publisher-signed release artifacts, gitleaks and lychee are built
# from pinned source. Prints the local image tag; fails closed.
tool_image() { "$ROOT/build/tools/tool.sh" "$1"; }

# Networked containers get single files, not the repo (reviews DD-4, EE-2). Each code list must
# equal its entry's import closure, no more and no less: `./seclab lint mounts` checks it
# (build/import-closure.ts). Data files are listed apart and reviewed by hand.
VERIFY_IMAGE_FILES=(build/verify-image.ts build/registry.ts)
DEPS_OUTDATED_FILES=(build/deps-outdated.ts build/registry.ts build/release-dates.ts)
DEPS_OUTDATED_DATA=(deps/registry.json)
LIVENESS_VERIFY_FILES=(build/liveness/liveness.ts)
LIVENESS_VERIFY_DATA=(build/liveness/register.json)
# Sets MOUNTS to -v flags mounting each listed file read-only at /d/<path> (bash 3.2: no mapfile;
# an empty list would abort "${MOUNTS[@]}" under set -u there, so it is refused: JJJ-3).
mount_files() { local f; [[ $# -gt 0 ]] || { echo "mount_files: empty list" >&2; return 1; }; MOUNTS=(); for f in "$@"; do MOUNTS+=(-v "$ROOT/$f:/d/$f:ro"); done; }

# Workflow static analysis (EDR ci-hardening): actionlint, then zizmor, both offline with no
# network and no credentials: they are third-party images (ADR supply-chain provenance).
# zizmor's online audits (impostor commits, ref confusion) are covered by the repo's
# sha_pinning_required setting and the GitHub-owned-actions allowlist.
lint_workflows() {
	local actionlint
	actionlint="$(tool_image actionlint)"
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$actionlint" -no-color
	verify_signed_image "$ZIZMOR_IMAGE" '^https://github\.com/docker/github-builder/\.github/workflows/build\.yml@' zizmorcore/zizmor refs/tags/v1.31.1
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$ZIZMOR_IMAGE" --offline --no-progress --persona=regular .github/workflows
	# Actions logs here are public: no workflow or CI script echoes env, secrets or host data.
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" sh -ec 'node build/check-workflow-echo.ts --self-test; node build/check-workflow-echo.ts'
}

# Publisher-signature check before use (ADR supply-chain provenance), for images whose
# publisher signs each platform's BuildKit attestation (docker/github-builder). Every platform
# image in the pinned index must have an attestation naming it (build/verify-image.ts), and
# each attestation must carry a cosign keyless signature from the expected builder identity,
# calling repository and tag. Cached per index digest; needs network once (registry, TUF root).
# The verifier is cosign from build/tools (its own release signature verified by sigstore-python).
verify_signed_image() {
	local image="$1" identity="$2" wf_repo="$3" wf_ref="$4" digest marker repo line att key cosign
	cosign="$(tool_image cosign)"
	digest="${image##*@}"
	repo="${image%%@*}"; repo="${repo%:*}"
	# Keyed by digest AND the expected identity, so tightening the identity re-verifies (DD-5);
	# CI always re-verifies (no cache there).
	key="$(printf '%s\n' "$digest" "$identity" "$wf_repo" "$wf_ref" "$cosign" | shasum -a 256 | cut -c1-64)"
	marker="$ROOT/.work/deps-verified/$key"
	[[ -z "${CI:-}" && -f "$marker" ]] && return 0
	local pairs
	# Only the listed scripts are mounted: the verifier sees no repo content or run state (DD-4).
	mount_files "${VERIFY_IMAGE_FILES[@]}"
	pairs="$(docker run --rm "${MOUNTS[@]}" -w /d "$(node_image)" node build/verify-image.ts "$repo@$digest")" \
		|| { echo "verify: $image: attestation chain incomplete (refusing to run it)" >&2; return 1; }
	while read -r line; do
		att="${line##* }"
		docker run --rm "$cosign" verify --certificate-oidc-issuer https://token.actions.githubusercontent.com \
			--certificate-identity-regexp "$identity" --certificate-github-workflow-repository "$wf_repo" \
			--certificate-github-workflow-ref "$wf_ref" "$repo@$att" >/dev/null 2>&1 \
			|| { echo "verify: $image: signature on $att (${line%% *}) does not verify as $wf_repo@$wf_ref (refusing to run it)" >&2; return 1; }
	done <<<"$pairs"
	mkdir -p "$(dirname "$marker")"
	printf '%s\n' "$pairs" > "$marker"
	echo "verify: $image: publisher signature verified ($wf_repo@$wf_ref)" >&2
}

# Host prerequisites (user-approved exception, docs/edr/20261105-supply-chain-exceptions.md).
# gh: the installed binary must be byte-identical to the one in cli/cli's attested release
# archive for its version (gh attestation verify, signer workflow pinned). This catches a
# substituted or differently built gh; it can't catch a gh that lies about itself, and GitHub
# signs these attestations with its own Sigstore instance, so no second verifier applies.
# macOS: Docker Desktop, the docker CLI and sbx must carry a valid Developer ID signature from
# Docker, Inc. (team 9BNSXJN65R). Read-only: downloads go to .work/deps-host, nothing installs.
DOCKER_TEAM_ID=9BNSXJN65R
deps_host() {
	local gh real ver asset dir got want p bad=0
	gh="$(command -v gh)" || { echo "deps host: gh not found" >&2; return 1; }
	real="$(realpath "$gh")"
	ver="$(gh --version | sed -n '1s/^gh version \([0-9][0-9.]*\).*/\1/p')"
	case "$(uname -s)-$(uname -m)" in
		Darwin-arm64) asset="gh_${ver}_macOS_arm64.zip" ;; Darwin-x86_64) asset="gh_${ver}_macOS_amd64.zip" ;;
		Linux-aarch64) asset="gh_${ver}_linux_arm64.tar.gz" ;; Linux-x86_64) asset="gh_${ver}_linux_amd64.tar.gz" ;;
		*) echo "deps host: unsupported platform" >&2; return 1 ;;
	esac
	dir="$ROOT/.work/deps-host/gh-$ver"
	rm -rf "$dir" && mkdir -p "$dir/x"
	# Fetched with curl, not through the gh being checked (SS-3), plus the release's checksums.
	local rel="https://github.com/cli/cli/releases/download/v$ver"
	curl -fsSL --proto '=https' -o "$dir/$asset" "$rel/$asset"
	curl -fsSL --proto '=https' -o "$dir/checksums.txt" "$rel/gh_${ver}_checksums.txt"
	want="$(awk -v a="$asset" '$2 == a { print $1 }' "$dir/checksums.txt")"
	[[ "$want" =~ ^[0-9a-f]{64}$ && "$(shasum -a 256 "$dir/$asset" | cut -c1-64)" == "$want" ]] \
		|| { echo "gh $ver: $asset does not match the release's checksums file" >&2; return 1; }
	if gh attestation verify "$dir/$asset" --repo cli/cli --signer-workflow cli/cli/.github/workflows/deployment.yml >/dev/null 2>"$dir/verify.err"; then
		case "$asset" in *.zip) (cd "$dir/x" && unzip -q "../$asset") ;; *) tar -C "$dir/x" -xzf "$dir/$asset" ;; esac
		want="$(shasum -a 256 "$dir"/x/*/bin/gh | cut -c1-64)"
		got="$(shasum -a 256 "$real" | cut -c1-64)"
		if [[ "$got" == "$want" ]]; then
			echo "gh $ver ($real): byte-identical to cli/cli's attested release ($asset)"
		else
			echo "gh $ver ($real): NOT the attested release binary (sha256 $got, release $want; e.g. a Homebrew or distro build)" >&2; bad=1
		fi
	else
		echo "gh $ver: the release archive's attestation did not verify ($(tail -1 "$dir/verify.err"))" >&2; bad=1
	fi
	if [[ "$(uname -s)" == Darwin ]]; then
		for p in /Applications/Docker.app "$(command -v docker)" "$(command -v sbx)"; do
			[[ -e "$p" ]] || { echo "$p: not found" >&2; bad=1; continue; }
			real="$(realpath "$p")"
			# A designated requirement (SS-4): an Apple-anchored Developer ID chain whose leaf is Docker, Inc.'s team.
			if codesign --verify --strict -R="anchor apple generic and certificate leaf[subject.OU] = \"$DOCKER_TEAM_ID\"" "$real" 2>/dev/null; then
				echo "$p: valid Developer ID signature, Docker, Inc. ($DOCKER_TEAM_ID)"
			else
				echo "$p: signature invalid or not Docker, Inc.'s" >&2; bad=1
			fi
		done
	fi
	return "$bad"
}

# Secret scan of what a push adds (AGENTS.md; mechanical, not a reminder): gitleaks built from
# pinned source over every commit in BASE..TIP (`git log -p -m --text`: intermediate commits and
# merges included, binary-marked files shown as text; VV-1, VV-3), network-less, no credentials,
# findings redacted. BASE: the argument, else SECRETS_BASE (CI sets it only for pushes to main),
# else the merge base with origin/main, i.e. everything main doesn't have yet (VV-2). A base that
# isn't available falls back to that merge base (stricter, never looser). Fails closed if docker
# or the scanner is unavailable.
lint_secrets() {
	local base="${1:-${SECRETS_BASE:-}}" tip="${2:-HEAD}" gl
	git -C "$ROOT" cat-file -e "$tip^{commit}" 2>/dev/null || { echo "lint secrets: no such commit $tip" >&2; return 1; }
	if [[ -z "$base" || "$base" =~ ^0+$ ]] || ! git -C "$ROOT" cat-file -e "$base^{commit}" 2>/dev/null; then
		base="$(git -C "$ROOT" merge-base origin/main "$tip")"
	fi
	gl="$(tool_image gitleaks)" || { echo "lint secrets: no scanner (./seclab tool gitleaks)" >&2; return 1; }
	if ! git -C "$ROOT" -c color.ui=never -c core.quotePath=false log -p -m --text --no-ext-diff --no-textconv --no-color "$base".."$tip" \
		| docker run --rm -i --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
		--user 65534:65534 --pull never "$gl" stdin --no-banner --redact --verbose --exit-code 1 --log-level warn; then
		echo "lint secrets: gitleaks found something in $base..$tip (redacted above). Remove it; fixtures use generated or obviously fake values that match no real token format." >&2
		return 1
	fi
	echo "lint secrets: clean ($(git -C "$ROOT" rev-parse --short "$base")..$(git -C "$ROOT" rev-parse --short "$tip"))"
}

# The security findings register (EDR security-findings-register). The offline check runs against
# the register at the merge base with origin/main (new findings need explicit IDs; the baseline only
# shrinks: review QQQ-5/6), then every landed `fixed` entry's commit must be on HEAD's history
# (host git; CI's docs job has full history).
findings_ancestry() { # stdin: "<key>\t<sha>" lines; fails on any SHA that isn't a commit on HEAD
	local key sha bad=0
	while IFS=$'\t' read -r key sha; do
		[[ -z "$key" ]] && continue
		if [[ ! "$sha" =~ ^[0-9a-f]{7,40}$ ]] || ! git -C "$ROOT" merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
			echo "findings: $key: fix commit $sha is not on this branch's history" >&2
			bad=1
		fi
	done
	return $bad
}
findings_base() { # REV OUT: the register at REV into OUT; empty when REV predates it; fails on any other error (SSS-2)
	local rev="$1" out="$2" path=docs/security-reviews/findings.json listed
	[[ "$rev" =~ ^[0-9a-f]{7,40}$ ]] && git -C "$ROOT" cat-file -e "$rev^{commit}" 2>/dev/null || { echo "findings: base $rev is not a commit here" >&2; return 1; }
	listed="$(git -C "$ROOT" ls-tree "$rev" -- "$path")" || { echo "findings: can't read the tree at $rev" >&2; return 1; }
	if [[ -n "$listed" ]]; then
		git -C "$ROOT" show "$rev:$path" > "$out" || { echo "findings: can't read $path at $rev" >&2; return 1; }
	else
		: > "$out"
	fi
}
findings_presence() { # HERE BASE MAIN (1/0 each): may this tree go without a register? (WWW-2)
	[[ "$1" = 1 ]] && return 0
	[[ "$2" = 0 && "$3" = 0 ]]
}
# Every commit the register cites (stdin from findings.ts shas: "<token>\t<0|1 upstream pin>\t<branch
# or ->\t<use>") is a commit on HEAD's or main's history or, for an entry carrying `branch`, on
# origin/<branch> (review YYY). The object is resolved by `rev-parse --disambiguate`, so no ref
# named like a token can shadow it, and an ambiguous prefix is reported as such. An exempt token
# (a prefix of the upstream pin) must not be a commit here. A branch entry whose branch no
# longer holds its commit fails only a change that writes the register (the change that must remap
# it); any other change lists it, so an unrelated landing isn't blocked (YYY-5).
findings_resolve() { # TOKEN -> the full commit id; 1 unknown or not a commit, 2 ambiguous
	local objs n
	[[ "$1" =~ ^[0-9a-f]{7,40}$ ]] || return 1
	objs="$(git -C "$ROOT" rev-parse --disambiguate="$1" 2>/dev/null)" || return 1
	n="$(grep -c . <<<"$objs")"
	[[ "$n" -gt 1 ]] && return 2
	[[ "$n" -eq 1 && "$(git -C "$ROOT" cat-file -t "$objs" 2>/dev/null)" == commit ]] || return 1
	echo "$objs"
}
findings_reachable() { # TOKEN BRANCH(- for none): 0 live, 1 not live, 2 ambiguous
	local c rc=0 main
	c="$(findings_resolve "$1")" || rc=$?
	[[ $rc -ne 0 ]] && return $rc
	git -C "$ROOT" merge-base --is-ancestor "$c" HEAD 2>/dev/null && return 0
	main="$(git -C "$ROOT" rev-parse -q --verify refs/remotes/origin/main)" && git -C "$ROOT" merge-base --is-ancestor "$c" "$main" 2>/dev/null && return 0
	[[ "$2" != - && "$2" =~ ^[A-Za-z0-9._/-]+$ && "$2" != *..* ]] || return 1
	git -C "$ROOT" rev-parse -q --verify "refs/remotes/origin/$2" >/dev/null || return 1
	git -C "$ROOT" merge-base --is-ancestor "$c" "refs/remotes/origin/$2" 2>/dev/null
}
findings_shas() { # STRICT (1: every citation; 0: only touched entries'). stdin: findings.ts shas
	local t up br touched use extra rc where hint bad=0 stale=0 hard
	while IFS=$'\t' read -r t up br touched use extra; do
		[[ -z "$t$up$br$touched$use$extra" ]] && continue
		# The two halves' contract is checked, never assumed: a malformed line fails (ZZZ-2).
		if [[ ! "$up" =~ ^[01]$ || ! "$touched" =~ ^[01]$ || -z "$br" || -z "$use" || -n "$extra" ]]; then
			echo "findings: malformed citation line from findings.ts shas; refusing to judge it" >&2; bad=1; continue
		fi
		hard=0; [[ "$1" = 1 || "$touched" = 1 ]] && hard=1
		rc=0; findings_reachable "$t" "$br" || rc=$?
		if [[ $rc -eq 2 ]]; then # an ambiguous prefix, exempt or not (ZZZ-5)
			if [[ $hard = 1 ]]; then echo "findings: $use cites $t, which is an ambiguous prefix here; cite more characters" >&2; bad=1
			else echo "findings: warning: $use cites $t, an ambiguous prefix here, in an entry this change doesn't touch" >&2; stale=$((stale+1)); fi
			continue
		fi
		if [[ "$up" = 1 ]]; then
			[[ $rc -eq 0 ]] || continue
			echo "findings: $use cites $t as the upstream pin, but it is a commit here" >&2; bad=1
			continue
		fi
		[[ $rc -eq 0 ]] && continue
		where="main's history" hint=""
		[[ "$br" != - ]] && { where+=" or origin/$br"; hint=" (./seclab findings remap --branch $br)"; }
		if [[ $hard = 0 ]]; then
			echo "findings: warning: $use cites $t, no longer on $where, in an entry this change doesn't touch$hint" >&2
			stale=$((stale+1))
		else
			echo "findings: $use cites $t, which isn't a commit on $where: remap it to its equivalent commit$hint" >&2; bad=1
		fi
	done
	[[ $stale -gt 0 ]] && echo "findings: $stale rotted citation(s) in entries this change doesn't touch (warnings above)" >&2
	return $bad
}
# Self-service remap (review ZZZ): a rebased branch's register citations follow it. The old commit
# must still be a local object; its equivalent is the one commit in the branch's history (main's
# included) with the same patch-id, else the one with the same subject and file list. Anything
# else is reported, never guessed.
findings_pids() { # TIP: "<patch-id> <commit>" for its recent history
	git -C "$ROOT" log -p --no-merges --max-count=3000 "$1" | git -C "$ROOT" patch-id --stable
}
findings_equiv() { # OLD TIP PIDFILE -> "<new>\t<method>"; 1 none, 2 ambiguous, 3 old not a commit here
	local c pid hits n files cand
	c="$(findings_resolve "$1")" || return 3
	if git -C "$ROOT" merge-base --is-ancestor "$c" "$2" 2>/dev/null; then printf '%s\tunchanged\n' "$c"; return 0; fi
	pid="$(git -C "$ROOT" show "$c" | git -C "$ROOT" patch-id --stable | cut -d' ' -f1)"
	if [[ -n "$pid" ]]; then
		hits="$(awk -v p="$pid" '$1 == p { print $2 }' "$3" | sort -u)"
		n="$(grep -c . <<<"$hits" || true)"
		[[ "$n" -gt 1 ]] && return 2
		[[ "$n" -eq 1 ]] && { printf '%s\tpatch-id\n' "$hits"; return 0; }
	fi
	files="$(git -C "$ROOT" show --format= --name-only "$c" | sort)"
	hits=""
	while IFS= read -r cand; do
		[[ "$(git -C "$ROOT" show --format= --name-only "$cand" | sort)" == "$files" ]] && hits+="$cand"$'\n'
	done < <(git -C "$ROOT" log --no-merges --max-count=3000 --format=$'%H\t%s' "$2" | S="$(git -C "$ROOT" log -1 --format=%s "$c")" awk -F'\t' 'ENVIRON["S"] == $2 { print $1 }')
	n="$(grep -c . <<<"$hits" || true)"
	[[ "$n" -gt 1 ]] && return 2
	[[ "$n" -eq 1 ]] || return 1
	printf '%s\tsubject and files\n' "${hits%$'\n'}"
}
findings_remap() { # BRANCH
	local br="$1" tip list t up b touched use rc out pairs="$ROOT/.work/findings-remap.tsv" pids="$ROOT/.work/findings-pids.txt" left=0 n=0
	[[ "$br" =~ ^[A-Za-z0-9._/-]+$ && "$br" != *..* && "$br" != -* ]] || { echo "findings remap: bad branch name" >&2; return 2; }
	tip="$(git -C "$ROOT" rev-parse -q --verify "refs/remotes/origin/$br^{commit}")" || { echo "findings remap: no origin/$br here (git fetch origin)" >&2; return 1; }
	mkdir -p "$ROOT/.work"; : > "$pairs"
	list="$(docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts shas)" || return 1
	findings_pids "$tip" > "$pids" || return 1
	while IFS=$'\t' read -r t up b touched use; do
		[[ -z "$t" || "$b" != "$br" || "$up" = 1 ]] && continue
		findings_reachable "$t" "$b" && continue
		# A round label is its record's text: remap never rewrites one, so never claims it (ZZZ-3).
		if [[ "$use" == *" round" ]]; then echo "findings remap: $use: $t is in a round label; remap it by hand" >&2; left=$((left+1)); continue; fi
		rc=0; out="$(findings_equiv "$t" "$tip" "$pids")" || rc=$?
		case $rc in
			0) printf '%s\t%s\n' "$t" "${out%%$'\t'*}" >> "$pairs"; n=$((n+1)); echo "findings remap: $use: $t -> ${out:0:7} (${out#*$'\t'})" ;;
			1) echo "findings remap: $use: $t has no equivalent on origin/$br; remap it by hand" >&2; left=$((left+1)) ;;
			2) echo "findings remap: $use: $t has several candidates on origin/$br; remap it by hand" >&2; left=$((left+1)) ;;
			*) echo "findings remap: $use: $t is not a commit here (fetch the old commits, or remap it by hand)" >&2; left=$((left+1)) ;;
		esac
	done <<<"$list"
	sort -u -o "$pairs" "$pairs"
	if [[ $n -gt 0 ]]; then
		docker run --rm --network none -u "$(id -u):$(id -g)" -v "$ROOT:/repo" -w /repo "$(node_image)" node build/docs/findings.ts remap "$br" .work/findings-remap.tsv || return 1
		docker run --rm --network none -u "$(id -u):$(id -g)" -v "$ROOT:/repo" -w /repo "$(node_image)" node build/docs/findings.ts write || return 1
	fi
	echo "findings remap: $n citation(s) remapped, $left left to remap by hand"
	[[ $left -eq 0 ]]
}
# On main (HEAD is the merge base): what to compare with, given the push's previous head. Unset
# (local runs): the first parent. Never HEAD itself. A previous head that isn't an ancestor (a
# force-push) never narrows the comparison: its merge base with HEAD is older, so stricter; one
# that isn't a commit here, or shares no history, fails (XXX-6).
findings_main_base() { # PREVIOUS_HEAD
	local prev="$1" head
	head="$(git -C "$ROOT" rev-parse HEAD)"
	if [[ -z "$prev" || "$prev" =~ ^0+$ || "$prev" == "$head" ]]; then
		git -C "$ROOT" rev-parse -q --verify 'HEAD^1^{commit}' || { echo "findings: HEAD is main with no parent to compare with" >&2; return 1; }
	elif [[ ! "$prev" =~ ^[0-9a-f]{40}$ ]] || ! git -C "$ROOT" cat-file -e "$prev^{commit}" 2>/dev/null; then
		echo "findings: on main, the previous head ${prev:0:40} isn't a commit here (force-push?); refusing to compare with less" >&2
		return 1
	elif git -C "$ROOT" merge-base --is-ancestor "$prev" HEAD 2>/dev/null; then
		echo "$prev"
	else
		git -C "$ROOT" merge-base "$prev" HEAD || { echo "findings: on main, the previous head $prev shares no history with HEAD; refusing to compare with less" >&2; return 1; }
	fi
}
findings_check() {
	local mb rev list main
	mkdir -p "$ROOT/.work"
	main="$(git -C "$ROOT" rev-parse --verify -q origin/main)" || { echo "findings: no origin/main (fetch it)" >&2; exit 1; }
	mb="$(git -C "$ROOT" merge-base "$main" HEAD)" || { echo "findings: no merge base with origin/main" >&2; exit 1; }
	rev="$mb"
	# On main itself the merge base is HEAD: compare with the push's previous head instead
	# (validated before git sees it: TTT-11), else the first parent (TTT-7). Never HEAD itself.
	# A previous head that isn't an ancestor (a force-push) never narrows the comparison to one
	# commit: use its merge base with HEAD (stricter), and fail if there is none (XXX-6).
	if [[ "$mb" == "$(git -C "$ROOT" rev-parse HEAD)" ]]; then
		rev="$(findings_main_base "${DOCS_BASE:-}")" || exit 1
		echo "findings: on main; comparing with $rev"
	fi
	findings_base "$rev" "$ROOT/.work/findings-base.json" || exit 1
	local base_had=1 main_has=0
	[[ -s "$ROOT/.work/findings-base.json" ]] || base_had=0
	git -C "$ROOT" cat-file -e "$main:docs/security-reviews/findings.json" 2>/dev/null && main_has=1
	if [[ ! -f "$ROOT/docs/security-reviews/findings.json" ]]; then
		# Gone while the base or main has it: fail (a removal, or a branch that must rebase to adopt
		# the register before it can land). Skip only when neither ever had one (WWW-2).
		if ! findings_presence 0 "$base_had" "$main_has"; then
			echo "findings: docs/security-reviews/findings.json is missing, but ${rev:0:12} or origin/main has it; rebase onto main to adopt it" >&2
			exit 1
		fi
		echo "findings: no register here or on origin/main; skipped"
		return 0
	fi
	# A branch forked before the register landed, that has it now, is judged against main's
	# register. Not on main itself, where that would compare the register with itself (UUU-6).
	if [[ $base_had = 0 && "$mb" != "$(git -C "$ROOT" rev-parse HEAD)" ]]; then
		findings_base "$main" "$ROOT/.work/findings-base.json" || exit 1
	fi
	# What this change writes, committed or not (VVV-6), and owner-acceptances.md as it was at the
	# base: a high is closed by an owner row only once that row has landed (UUU-4, VVV-3).
	{ git -C "$ROOT" diff --name-only "$rev" HEAD && git -C "$ROOT" diff --name-only HEAD && git -C "$ROOT" ls-files --others --exclude-standard; } \
		| sort -u > "$ROOT/.work/findings-changed.txt" || { echo "findings: can't list the files changed since $rev" >&2; exit 1; }
	rm -rf "$ROOT/.work/findings-before"
	mkdir -p "$ROOT/.work/findings-before/docs/security-reviews"
	# The owner file is a regular tracked file, so its path names its content (XXX-7).
	local own=docs/security-reviews/owner-acceptances.md mode
	if [[ -e "$ROOT/$own" || -L "$ROOT/$own" ]]; then
		mode="$(git -C "$ROOT" ls-files -s -- "$own" | cut -d' ' -f1)"
		if [[ -L "$ROOT/$own" || ! -f "$ROOT/$own" || ( -n "$mode" && "$mode" != 100644 ) ]]; then
			echo "findings: $own must be a regular file (mode 100644)" >&2
			exit 1
		fi
	fi
	if git -C "$ROOT" cat-file -e "$rev:docs/security-reviews/owner-acceptances.md" 2>/dev/null; then
		git -C "$ROOT" show "$rev:docs/security-reviews/owner-acceptances.md" > "$ROOT/.work/findings-before/docs/security-reviews/owner-acceptances.md" || exit 1
	fi
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts check --base .work/findings-base.json --changed .work/findings-changed.txt --before .work/findings-before
	list="$(docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts commits)"
	findings_ancestry <<<"$list" || exit 1
	echo "findings: every fixed entry's commit is on HEAD's history"
	list="$(docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts shas --base .work/findings-base.json)" || exit 1
	# A new upstream pin changes which tokens are exempt, so every citation answers (ZZZ-1).
	local strict=0
	grep -qx 'upstream.lock' "$ROOT/.work/findings-changed.txt" && strict=1
	findings_shas "$strict" <<<"$list" || exit 1
	echo "findings: every commit an entry this change adds or modifies cites is on main's history or its entry's branch"
}
# The host half's own injections (QQQ-9, SSS-9): ancestry (a non-ancestor SHA, an option-shaped
# value, a control) and base resolution (a commit before the register, a non-commit, a control).
findings_host_self_test() {
	local head root out="$ROOT/.work/findings-base-selftest.json"
	mkdir -p "$ROOT/.work"
	head="$(git -C "$ROOT" rev-parse HEAD)"
	printf 'control\t%s\n' "$head" | findings_ancestry || { echo "findings host self-test: the control (HEAD) failed" >&2; exit 1; }
	if printf 'x\t%s\n' 0123456789abcdef0123456789abcdef01234567 | findings_ancestry 2>/dev/null; then echo "findings host self-test: a non-ancestor SHA passed" >&2; exit 1; fi
	if printf 'x\t%s\n' '--upload-pack=x' | findings_ancestry 2>/dev/null; then echo "findings host self-test: an option-shaped SHA passed" >&2; exit 1; fi
	root="$(git -C "$ROOT" rev-list --max-parents=0 HEAD | tail -1)"
	findings_base "$root" "$out" && [[ ! -s "$out" ]] || { echo "findings host self-test: a commit before the register didn't give an empty base" >&2; exit 1; }
	if findings_base 0123456789abcdef0123456789abcdef01234567 "$out" 2>/dev/null; then echo "findings host self-test: a missing base commit didn't fail" >&2; exit 1; fi
	if [[ -f "$ROOT/docs/security-reviews/findings.json" ]] && git -C "$ROOT" ls-files --error-unmatch docs/security-reviews/findings.json >/dev/null 2>&1; then
		findings_base "$head" "$out" && [[ -s "$out" ]] || { echo "findings host self-test: the control (HEAD's register) was empty" >&2; exit 1; }
	fi
	rm -f "$out"
	# WWW-2: a tree without the register passes only when neither the base nor main ever had one.
	if findings_presence 0 0 1; then echo "findings host self-test: a missing register passed while main has one (WWW-2)" >&2; exit 1; fi
	if findings_presence 0 1 0; then echo "findings host self-test: a missing register passed while the base has one" >&2; exit 1; fi
	findings_presence 0 0 0 || { echo "findings host self-test: the control (no register anywhere) failed" >&2; exit 1; }
	# XXX-6: on main, a force-pushed previous head compares with its merge base, never with less.
	local p1 got side
	p1="$(git -C "$ROOT" rev-parse -q --verify 'HEAD^1^{commit}')" || { echo "findings host self-test: HEAD has no parent" >&2; exit 1; }
	got="$(findings_main_base "")" && [[ "$got" == "$p1" ]] || { echo "findings host self-test: the control (no previous head) didn't give HEAD^1" >&2; exit 1; }
	got="$(findings_main_base "$root")" && [[ "$got" == "$root" ]] || { echo "findings host self-test: the control (an ancestor) wasn't used as is" >&2; exit 1; }
	side="$(GIT_AUTHOR_NAME=selftest GIT_AUTHOR_EMAIL=selftest@example.invalid GIT_COMMITTER_NAME=selftest GIT_COMMITTER_EMAIL=selftest@example.invalid git -C "$ROOT" commit-tree -p "$root" -m side "$(git -C "$ROOT" rev-parse "$root^{tree}")")" || { echo "findings host self-test: can't make a side commit" >&2; exit 1; }
	got="$(findings_main_base "$side")" && [[ "$got" == "$root" ]] || { echo "findings host self-test: a force-pushed previous head didn't compare with its merge base (XXX-6)" >&2; exit 1; }
	if findings_main_base 0123456789abcdef0123456789abcdef01234567 >/dev/null 2>&1; then echo "findings host self-test: a previous head that isn't a commit passed (XXX-6)" >&2; exit 1; fi
	if findings_main_base '--upload-pack=x' >/dev/null 2>&1; then echo "findings host self-test: an option-shaped previous head passed" >&2; exit 1; fi
	side="$(GIT_AUTHOR_NAME=selftest GIT_AUTHOR_EMAIL=selftest@example.invalid GIT_COMMITTER_NAME=selftest GIT_COMMITTER_EMAIL=selftest@example.invalid git -C "$ROOT" commit-tree -m orphan "$(git -C "$ROOT" rev-parse "$root^{tree}")")" || { echo "findings host self-test: can't make an orphan commit" >&2; exit 1; }
	if findings_main_base "$side" >/dev/null 2>&1; then echo "findings host self-test: a previous head with no shared history passed (XXX-6)" >&2; exit 1; fi
	# Commit citations: a dangling commit (the orphan above, on no ref) fails untolerated, and so
	# does a non-commit token; a tolerated non-commit passes; a tolerated reachable commit fails.
	printf '%s\t0\t-\t1\tcontrol\n' "$head" | findings_shas 0 || { echo "findings host self-test: the control (HEAD cited) failed" >&2; exit 1; }
	if printf '%s\t0\t-\t1\tx\n' "$side" | findings_shas 0 2>/dev/null; then echo "findings host self-test: a dangling commit citation passed" >&2; exit 1; fi
	printf '%s\t0\t-\t0\tx\n' "$side" | findings_shas 0 2>/dev/null || { echo "findings host self-test: a rotted citation in an untouched entry blocked the change (ZZZ)" >&2; exit 1; }
	if printf '%s\t0\t-\t0\tx\n' "$side" | findings_shas 1 2>/dev/null; then echo "findings host self-test: a rotted citation in an untouched entry passed the strict listing (ZZZ)" >&2; exit 1; fi
	if printf '%s\t0\tmain\t1\tx\n' "$side" | findings_shas 0 2>/dev/null; then echo "findings host self-test: a branch entry's commit not on its branch passed in a register change" >&2; exit 1; fi
	printf '%s\t0\tno-such-branch\t0\tx\n' "$side" | findings_shas 0 2>/dev/null || { echo "findings host self-test: a stale branch-entry citation blocked a change that doesn't write the register (YYY-5)" >&2; exit 1; }
	if printf 'abcdef0123456\t0\t-\t1\tx\n' | findings_shas 0 2>/dev/null; then echo "findings host self-test: a non-commit token passed" >&2; exit 1; fi
	printf 'abcdef0123456\t1\t-\t1\tx\n' | findings_shas 1 || { echo "findings host self-test: the control (the upstream pin, not a commit here) failed" >&2; exit 1; }
	if printf '%s\t1\t-\t0\tx\n' "$head" | findings_shas 0 2>/dev/null; then echo "findings host self-test: an upstream-pin token that is a commit here passed" >&2; exit 1; fi
	if printf -- '--all\t0\t-\t1\tx\n' | findings_shas 0 2>/dev/null; then echo "findings host self-test: an option-shaped token passed" >&2; exit 1; fi
	if printf '%s\t0\t../x\t1\tx\n' "$side" | findings_shas 0 2>/dev/null; then echo "findings host self-test: a path-shaped branch passed" >&2; exit 1; fi
	# ZZZ-2: a malformed line fails, never reads as untouched; the real shas output parses.
	if printf '%s\t0\t-\tx\n' "$side" | findings_shas 0 2>/dev/null; then echo "findings host self-test: a four-column citation line passed (ZZZ-2)" >&2; exit 1; fi
	if printf '%s\t0\t-\tyes\tx\n' "$side" | findings_shas 0 2>/dev/null; then echo "findings host self-test: a non-0/1 touched column passed (ZZZ-2)" >&2; exit 1; fi
	if printf '%s\t0\t-\t0\tx\textra\n' "$side" | findings_shas 0 2>/dev/null; then echo "findings host self-test: a six-column citation line passed (ZZZ-2)" >&2; exit 1; fi
	if [[ -f "$ROOT/docs/security-reviews/findings.json" ]]; then
		docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts shas 2>/dev/null \
			| awk -F'\t' 'NF != 5 || ($2 != 0 && $2 != 1) || ($4 != 0 && $4 != 1) { bad = 1 } END { exit bad }' \
			|| { echo "findings host self-test: findings.ts shas output breaks the five-column contract (ZZZ-2)" >&2; exit 1; }
	fi
	# ZZZ: findings_equiv follows a rebased commit by patch-id, else subject and files, and
	# refuses to guess. Unreferenced objects only: no ref is written.
	local idx="$ROOT/.work/findings-selftest.index" pids="$ROOT/.work/findings-selftest.pids" t0 t1 t2 t3 s2 a a2 c a3 d d2 e got
	export GIT_AUTHOR_NAME=selftest GIT_AUTHOR_EMAIL=selftest@example.invalid GIT_COMMITTER_NAME=selftest GIT_COMMITTER_EMAIL=selftest@example.invalid
	findings_st_tree() { # CONTENT -> root's tree plus selftest-equiv.txt holding CONTENT
		local blob; blob="$(printf '%s\n' "$1" | git -C "$ROOT" hash-object -w --stdin)"
		GIT_INDEX_FILE="$idx" git -C "$ROOT" read-tree "$root" && GIT_INDEX_FILE="$idx" git -C "$ROOT" update-index --add --cacheinfo "100644,$blob,selftest-equiv.txt" && GIT_INDEX_FILE="$idx" git -C "$ROOT" write-tree
	}
	t0="$(git -C "$ROOT" rev-parse "$root^{tree}")"; t1="$(findings_st_tree a)"; t2="$(findings_st_tree b)"; t3="$(findings_st_tree b-amended)"
	s2="$(git -C "$ROOT" commit-tree -p "$root" -m 'selftest: base' "$t0")"
	a="$(git -C "$ROOT" commit-tree -p "$root" -m 'selftest: equiv' "$t1")"
	a2="$(git -C "$ROOT" commit-tree -p "$s2" -m 'selftest: equiv' "$t1")"
	findings_pids "$a2" > "$pids"
	got="$(findings_equiv "$a" "$a2" "$pids")" && [[ "$got" == "$a2"$'\t'patch-id ]] || { echo "findings host self-test: a rebased commit wasn't followed by patch-id (ZZZ)" >&2; exit 1; }
	got="$(findings_equiv "$a2" "$a2" "$pids")" && [[ "$got" == "$a2"$'\t'unchanged ]] || { echo "findings host self-test: the control (a commit still on the branch) failed" >&2; exit 1; }
	c="$(git -C "$ROOT" commit-tree -p "$a2" -m 'selftest: revert' "$t0")"; a3="$(git -C "$ROOT" commit-tree -p "$c" -m 'selftest: again' "$t1")"
	findings_pids "$a3" > "$pids"
	if findings_equiv "$a" "$a3" "$pids" >/dev/null; then echo "findings host self-test: two commits with the same patch-id didn't count as ambiguous (ZZZ)" >&2; exit 1; fi
	d="$(git -C "$ROOT" commit-tree -p "$root" -m 'selftest: amended' "$t2")"; d2="$(git -C "$ROOT" commit-tree -p "$s2" -m 'selftest: amended' "$t3")"
	findings_pids "$d2" > "$pids"
	got="$(findings_equiv "$d" "$d2" "$pids")" && [[ "$got" == "$d2"$'\t'"subject and files" ]] || { echo "findings host self-test: an amended commit wasn't followed by subject and files (ZZZ)" >&2; exit 1; }
	e="$(git -C "$ROOT" commit-tree -p "$root" -m 'selftest: lonely' "$t2")"
	rc=0; findings_equiv "$e" "$a2" "$pids" >/dev/null || rc=$?
	[[ $rc -eq 1 ]] || { echo "findings host self-test: a commit with no equivalent wasn't reported as such (ZZZ)" >&2; exit 1; }
	rc=0; findings_equiv "$t0" "$a2" "$pids" >/dev/null || rc=$?
	[[ $rc -eq 3 ]] || { echo "findings host self-test: a non-commit old token wasn't refused (ZZZ)" >&2; exit 1; }
	rm -f "$idx" "$pids"
	# YYY-4: a ref named like a token doesn't stand in for the object; resolution ignores refs.
	[[ "$(findings_resolve "${head:0:12}")" == "$head" ]] || { echo "findings host self-test: the control (resolving HEAD's prefix) failed" >&2; exit 1; }
	if findings_resolve "$(git -C "$ROOT" rev-parse HEAD^{tree})" >/dev/null 2>&1; then echo "findings host self-test: a tree object resolved as a commit" >&2; exit 1; fi
	echo "findings host self-test: ok"
}

docs_check() {
	local run=0 online=0 paired=0
	for a in "$@"; do
		case "$a" in
			--run-commands) run=1 ;; --online) online=1 ;; --paired) paired=1 ;;
			*) usage; exit 2 ;;
		esac
	done
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/docs-check.ts check
	findings_check
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node tabd/tools/gen-obs-docs.ts check
	git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/deps.ts check -
	if [[ -d "$ROOT/broker" ]]; then
		[[ -f "$ROOT/broker/docs-check.sh" ]] || { echo "docs-check: broker/ exists but broker/docs-check.sh is missing" >&2; exit 1; }
		if [[ $run = 1 ]]; then bash "$ROOT/broker/docs-check.sh" --run-commands; else bash "$ROOT/broker/docs-check.sh"; fi
	fi
	if [[ $paired = 1 ]]; then
		local base f
		# CI passes the exact base (PR base SHA, or the push's previous head); locally: origin/main.
		# A force-pushed branch's previous head no longer exists: fall back to the merge base
		# with origin/main, which covers every commit on the branch (stricter, not looser).
		base="${DOCS_BASE:-}"
		if [[ -z "$base" || "$base" =~ ^0+$ ]] || ! git -C "$ROOT" cat-file -e "$base^{commit}" 2>/dev/null; then
			[[ -n "$base" && ! "$base" =~ ^0+$ ]] && echo "docs-check: paired base $base not available; using merge-base with origin/main" >&2
			base="$(git -C "$ROOT" merge-base origin/main HEAD)"
		fi
		git -C "$ROOT" cat-file -e "$base^{commit}" || { echo "docs-check: paired base $base not available (shallow clone?)" >&2; exit 1; }
		f="$ROOT/.work/docs-paired.txt"
		mkdir -p "$ROOT/.work"
		{ git -C "$ROOT" diff --name-only "$base"..HEAD; echo '--'; git -C "$ROOT" log --format='%(trailers:key=docs-not-needed,valueonly)' "$base"..HEAD; } > "$f"
		docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/docs-check.ts paired .work/docs-paired.txt
	fi
	if [[ $online = 1 ]]; then
		# External links and permalinks must resolve; results are cached (named volume) so CI isn't flaky.
		# No credentials ever enter this third-party container (EDR supply-chain): GitHub rate
		# limits are absorbed by the cache and by accepting 429.
		docker run --rm -v "$ROOT:/input:ro" -v seclab-lychee-cache:/cache -w /cache "$(tool_image lychee)" \
			--no-progress --cache --max-cache-age 3d --max-concurrency 8 --accept 200,206,429 \
			--exclude-path /input/.work --exclude-path /input/vscode --exclude-path /input/node_modules \
			--exclude '^https?://([^/]+\.)?(test|invalid|example|localhost)(/|:|$)' --exclude '^https?://(127\.|localhost|host\.docker\.internal)' \
			--exclude '^vscode-remote:' --exclude '^https://github\.com/anticomputer/seclab-vscode' \
			'/input/**/*.md'
	fi
	if [[ $run = 1 ]]; then
		docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/docs-check.ts commands > "$ROOT/.work/docs-commands.sh"
		(cd "$ROOT" && bash -e .work/docs-commands.sh)
	fi
}

node_image() {
	# Same Node major as upstream's .nvmrc; used for tests so the host needs no toolchain.
	echo "node:24.22.1-trixie@sha256:f1e034976f948cf212ef1f659c12e5dd58ac7eab947831813e81a62401ca38be"
}

# The shared pre-push hook (EDR publish-gate, downgrade protection).
hooks_dir() { echo "$(cd "$(git -C "$ROOT" rev-parse --git-common-dir)" && pwd -P)/seclab-hooks"; }
sha256_of() { (command -v sha256sum >/dev/null && sha256sum "$1" || shasum -a 256 "$1") 2>/dev/null | cut -d' ' -f1; }
# One line per problem; empty when this worktree pushes through the locked gate hook. Checks the
# pointer git will actually use here (path-typed, per-worktree config included), not just the file.
hooks_problems() {
	local dir active mode
	dir="$(hooks_dir)"
	active="$(git -C "$ROOT" config --type=path core.hooksPath 2>/dev/null || true)"
	[[ "$active" != /* && -n "$active" ]] && active="$(git -C "$ROOT" rev-parse --show-toplevel)/$active"
	[[ -n "$active" && "$(cd "$active" 2>/dev/null && pwd -P)" == "$dir" ]] || echo "core.hooksPath here is not $dir"
	grep -q publish_gate "$dir/pre-push" 2>/dev/null || echo "the pre-push hook has no publish gate"
	[[ -f "$dir/.installed" && "$(sed -n 1p "$dir/.installed")" =~ ^[0-9a-f]{64}$ && "$(sed -n 1p "$dir/.installed")" == "$(sha256_of "$dir/pre-push")" ]] \
		|| echo "the pre-push hook is not the one the installer wrote"
	mode="$(stat -c '%a' "$dir" 2>/dev/null || stat -f '%Lp' "$dir" 2>/dev/null)"
	[[ "$mode" =~ ^[0-7]*[0-5][0-5][0-5]$ ]] || echo "the hook directory is not locked read-only"
}
# A loud warning, outside CI, when this worktree isn't pushing through the gate (R23-1).
hooks_warn() {
	[[ -n "${CI:-}" ]] && return 0
	local p
	p="$(hooks_problems 2>/dev/null)"
	[[ -z "$p" ]] || printf 'WARNING: pushes from here may not be gated: %s. Reinstall with main'"'"'s code (AGENTS.md).\n' "$(echo "$p" | paste -sd';' -)" >&2
}

fetch_macos() {
	local run="${1:-}"
	local dest="$ROOT/.work/app"
	local repo="anticomputer/seclab-vscode"
	local artifact="seclab-vscode-darwin-arm64" branch_build="${FETCH_BRANCH_BUILD:-}"
	[[ -n "$branch_build" ]] && { dest="$ROOT/.work/app-branch"; artifact="seclab-vscode-darwin-arm64-branch"; }
	if [[ -z "$run" ]]; then
		# Only builds of main triggered by a push (reviewed code), never dispatch/PR runs.
		run="$(gh run list -R "$repo" --workflow build-macos.yml --branch main --event push --status success --limit 1 --json databaseId --jq '.[0].databaseId')"
	fi
	[[ "$run" =~ ^[0-9]+$ ]] || { echo "no successful build-macos run on main found" >&2; exit 1; }
	local meta
	meta="$(gh run view -R "$repo" "$run" --json headBranch,event,conclusion,workflowName,headSha --jq '[.headBranch,.event,.conclusion,.workflowName,.headSha]|join(" ")')"
	read -r branch event conclusion workflow head_sha <<<"$meta"
	if [[ -n "$branch_build" ]]; then
		# A test build of an unlanded branch: dispatched, never main, never released.
		if [[ "$workflow" != "build-macos" || "$conclusion" != "success" || "$branch" == "main" || "$event" != "workflow_dispatch" || ! "$branch" =~ ^[A-Za-z0-9._/-]{1,100}$ ]]; then
			echo "refusing run $run: $meta (fetch macos-branch takes a successful dispatched build of a non-main branch)" >&2; exit 1
		fi
	elif [[ "$workflow" != "build-macos" || "$conclusion" != "success" || "$branch" != "main" || "$event" != "push" ]]; then
		echo "refusing run $run: $meta (only successful main push builds are released)" >&2; exit 1
	fi
	[[ "$head_sha" =~ ^[0-9a-f]{40}$ ]] || { echo "bad head SHA $head_sha" >&2; exit 1; }
	# The commit itself must have passed the gates, not just been built (CI-1): the required
	# checks (ci-unit, workflow-lint, docs-check) succeeded on this exact SHA.
	local c ok
	for c in unit lint docs; do
		# Latest attempt per check name (a re-run leaves the failed attempt as its own run).
		ok="$(gh api --paginate "repos/$repo/commits/$head_sha/check-runs?per_page=100" --jq ".check_runs[] | select(.name == \"$c\" and .app.slug == \"github-actions\") | [.id, .conclusion] | @tsv" \
			| sort -n | tail -1 | cut -f2)"
		[[ "$ok" == success ]] || { echo "refusing $head_sha: required check '$c' has not succeeded on it" >&2; exit 1; }
	done
	# Download into a private staging dir; verify there; extract only after re-hashing (CI-3).
	mkdir -p "$ROOT/.work"
	local stage
	stage="$(mktemp -d "$ROOT/.work/app-staging.XXXXXX")"
	chmod 700 "$stage"
	trap 'rm -rf "$stage"' RETURN
	gh run download -R "$repo" "$run" --name "$artifact" --dir "$stage/dl"
	# Integrity of the download (same artifact)...
	(cd "$stage/dl" && shasum -a 256 -c SHA256SUMS)
	# ...and provenance, before anything is extracted or run: signed by this repo's
	# build-macos workflow on a GitHub-hosted runner, from that branch (main for releases) at
	# that commit (EDR ci-hardening).
	local f
	for f in seclab-vscode-darwin-arm64.zip build-info.json; do
		gh attestation verify "$stage/dl/$f" -R "$repo" \
			--signer-workflow "$repo/.github/workflows/build-macos.yml" \
			--source-ref "refs/heads/$branch" --source-digest "$head_sha" --deny-self-hosted-runners >/dev/null \
			|| { echo "provenance verification failed for $f; not extracting" >&2; exit 1; }
	done
	echo "provenance verified: $repo build-macos.yml @ $branch $head_sha"
	# Parse, don't source: `.` would fire the RETURN trap above and delete the staging dir.
	local UPSTREAM_SHA
	UPSTREAM_SHA="$(sed -n 's/^UPSTREAM_SHA=\([0-9a-f]\{40\}\)$/\1/p' "$ROOT/upstream.lock")"
	[[ "$UPSTREAM_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "upstream.lock: no valid UPSTREAM_SHA" >&2; exit 1; }
	# A branch may pin another upstream: only its own commit is checked then.
	[[ -n "$branch_build" ]] && UPSTREAM_SHA="$(jq -r .upstreamSha "$stage/dl/build-info.json")"
	jq -e --arg u "$UPSTREAM_SHA" --arg h "$head_sha" '.upstreamSha == $u and .repoSha == $h and (has("testBuild") | not)' "$stage/dl/build-info.json" >/dev/null \
		|| { echo "build-info.json does not match upstream.lock / run head SHA, or is a test build" >&2; exit 1; }
	(cd "$stage/dl" && shasum -a 256 -c SHA256SUMS >/dev/null) || { echo "artifact changed after verification" >&2; exit 1; }
	ditto -x -k "$stage/dl/seclab-vscode-darwin-arm64.zip" "$stage/app"
	cp "$stage/dl/build-info.json" "$stage/dl/SHA256SUMS" "$stage/app/"
	rm -rf "$dest" && mv "$stage/app" "$dest"
	cat "$dest/build-info.json"
	echo
	grep seclab-vscode-darwin-arm64.zip "$dest/SHA256SUMS"
	echo "Unsigned app extracted to $dest. Gatekeeper will block it until quarantine is cleared;"
	echo "that step needs your explicit approval:  xattr -dr com.apple.quarantine \"$dest/seclab-vscode.app\""
}

# A test build variant (EDR test-build-variants): the renamed app and the hooked arm64 REH from
# one dispatched build-macos run with test_variant set, each attested by that workflow at that
# branch and commit. Into .work/test-builds/<variant>/ only, never the release or branch
# location. Both build-info files must record exactly the hooks this checkout's manifest lists.
fetch_test_variant() {
	local variant="$1" run="$2" repo="anticomputer/seclab-vscode"
	[[ "$variant" =~ ^[a-z][a-z0-9-]{0,31}$ ]] && jq -e --arg v "$variant" 'has($v)' "$ROOT/test/builds/variants.json" >/dev/null \
		|| { echo "unknown test variant '$variant' (test/builds/variants.json)" >&2; exit 2; }
	[[ "$run" =~ ^[0-9]+$ ]] || { echo "usage: ./seclab fetch macos-$variant RUN_ID" >&2; exit 2; }
	local dest="$ROOT/.work/test-builds/$variant" meta branch event conclusion workflow head_sha
	meta="$(gh run view -R "$repo" "$run" --json headBranch,event,conclusion,workflowName,headSha --jq '[.headBranch,.event,.conclusion,.workflowName,.headSha]|join(" ")')"
	read -r branch event conclusion workflow head_sha <<<"$meta"
	if [[ "$workflow" != "build-macos" || "$conclusion" != "success" || "$event" != "workflow_dispatch" || ! "$branch" =~ ^[A-Za-z0-9._/-]{1,100}$ || ! "$head_sha" =~ ^[0-9a-f]{40}$ ]]; then
		echo "refusing run $run: $meta (needs a successful dispatched build-macos run with test_variant=$variant)" >&2; exit 1
	fi
	# The run's whole tree (series, product transform, build scripts), not only its hook list, is
	# code this checkout has: its commit is HEAD or an ancestor (review CCC-3).
	git -C "$ROOT" merge-base --is-ancestor "$head_sha" HEAD 2>/dev/null \
		|| { echo "refusing run $run: its commit $head_sha ($branch) is not in this checkout's history; check it out first" >&2; exit 1; }
	mkdir -p "$ROOT/.work"
	local stage
	stage="$(mktemp -d "$ROOT/.work/test-staging.XXXXXX")"
	chmod 700 "$stage"
	trap 'rm -rf "$stage"' RETURN
	local app_zip="seclab-vscode-TEST-$variant-darwin-arm64.zip" reh_tgz="seclab-reh-linux-arm64-test-$variant.tar.gz" reh_info="build-info-test-$variant.json"
	gh run download -R "$repo" "$run" --name "seclab-vscode-darwin-arm64-test-$variant" --dir "$stage/app-dl"
	gh run download -R "$repo" "$run" --name "seclab-reh-linux-arm64-test-$variant" --dir "$stage/reh-dl"
	(cd "$stage/app-dl" && shasum -a 256 -c SHA256SUMS)
	local f
	for f in "app-dl/$app_zip" app-dl/build-info.json "reh-dl/$reh_tgz" "reh-dl/$reh_info"; do
		[[ -f "$stage/$f" ]] || { echo "missing $f in run $run" >&2; exit 1; }
		gh attestation verify "$stage/$f" -R "$repo" \
			--signer-workflow "$repo/.github/workflows/build-macos.yml" \
			--source-ref "refs/heads/$branch" --source-digest "$head_sha" --deny-self-hosted-runners >/dev/null \
			|| { echo "provenance verification failed for $f; not extracting" >&2; exit 1; }
	done
	echo "provenance verified: $repo build-macos.yml @ $branch $head_sha (test variant $variant)"
	# Both halves name this variant, its upstream and commit, and exactly the hooks the manifest
	# in this checkout lists for each target (same ids, patches and patch hashes).
	local want_app want_reh
	want_app="$("$ROOT/build/test-variant.sh" record "$variant" desktop)"
	want_reh="$("$ROOT/build/test-variant.sh" record "$variant" reh)"
	jq -e --arg h "$head_sha" --argjson w "$want_app" '.repoSha == $h and .testBuild == $w' "$stage/app-dl/build-info.json" >/dev/null \
		|| { echo "app build-info.json does not record $variant's desktop hooks at $head_sha (rebuild, or check out the run's commit)" >&2; exit 1; }
	jq -e --arg h "$head_sha" --argjson w "$want_reh" --arg u "$(jq -r .upstreamSha "$stage/app-dl/build-info.json")" \
		'.repoSha == $h and .upstreamSha == $u and .testBuild == $w' "$stage/reh-dl/$reh_info" >/dev/null \
		|| { echo "REH $reh_info does not record $variant's reh hooks at $head_sha with the app's upstream" >&2; exit 1; }
	(cd "$stage/app-dl" && shasum -a 256 -c SHA256SUMS >/dev/null) || { echo "artifact changed after verification" >&2; exit 1; }
	mkdir -p "$stage/out"
	ditto -x -k "$stage/app-dl/$app_zip" "$stage/out"
	cp "$stage/app-dl/build-info.json" "$stage/out/build-info-app.json"
	cp "$stage/reh-dl/$reh_tgz" "$stage/reh-dl/$reh_info" "$stage/out/"
	rm -rf "$dest" && mkdir -p "$(dirname "$dest")" && mv "$stage/out" "$dest"
	echo "UNSAFE test build '$variant' (never a release) in $dest:"
	ls "$dest"
	echo "Tab image from its REH: ./seclab image oci --test-variant $variant  (-> seclab-tab-oci:test-$variant)"
}

build_linux() {
	local targets="${*:-reh}" vol="${SECLAB_BUILD_VOLUME:-seclab-vscode-work}" offline=0 out="$OUT"
	local variant="${SECLAB_TEST_VARIANT:-}"
	# A test build variant (EDR test-build-variants) never shares the release build's volume or
	# output: its own volume (the hooked tree) and .work/test-builds/<variant>/.
	if [[ -n "$variant" ]]; then
		[[ "$variant" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || { echo "bad SECLAB_TEST_VARIANT" >&2; exit 2; }
		vol="seclab-test-$variant"; out="$ROOT/.work/test-builds/$variant"
	fi
	# A separate volume keeps an experimental tree (e.g. a test-only REH) out of the one that
	# builds what ships; the shared default is also CI's.
	[[ "$vol" =~ ^seclab-[a-z0-9-]{1,48}$ ]] || { echo "SECLAB_BUILD_VOLUME must be seclab-<name>" >&2; exit 2; }
	mkdir -p "$out"
	docker build -q -t seclab-builder:local "$ROOT/build/linux" >/dev/null
	# Durable named volume for the upstream checkout + node_modules (not /tmp, not the Mac FS).
	docker volume create "$vol" >/dev/null
	docker run --rm -u 0 -v "$vol:/work" seclab-builder:local chown builder:builder /work
	# Local builds fetch npm packages through GitHub CFS (EDR cfs-local-builds); hosted CI keeps
	# the public registry. Same lockfiles, same integrity hashes, different transport.
	if [[ -z "${CI:-}" ]]; then
		npm_fetch_cfs "$vol"
		offline=1
	fi
	docker run --rm \
		-v "$ROOT:/repo:ro" \
		-v "$vol:/work" \
		-v "$out:/out" \
		-e TARGETS="$targets" -e ARCH -e MAX_OLD_SPACE_SIZE -e GOGC -e SECLAB_NPM_OFFLINE="$offline" \
		-e SECLAB_TEST_VARIANT="$variant" -e GITHUB_SHA -e GITHUB_RUN_ID \
		seclab-builder:local bash /repo/build/linux/build.sh
}

# Fill the build volume's npm cache through CFS (EDR cfs-local-builds). The token goes only to
# `gh cfs -- docker build` as a BuildKit secret, for a fetch that runs no install script; the
# cache image (keyed by the lockfile set) holds only integrity-addressed tarballs. Then copied
# into the volume, where build.sh installs offline with no token.
npm_fetch_cfs() {
	local vol="$1" locks="$ROOT/.work/npm-locks" key img
	command -v gh >/dev/null && gh cfs version >/dev/null 2>&1 || { echo "build: local npm installs go through GitHub CFS; install gh-cfs (AGENTS.md)" >&2; exit 1; }
	docker run --rm -v "$ROOT:/repo:ro" -v "$vol:/work" -e PHASE=prepare seclab-builder:local bash /repo/build/linux/build.sh >/dev/null
	rm -rf "$locks" && mkdir -p "$locks"
	docker run --rm --network none -v "$vol:/work:ro" -v "$locks:/out" -w /work/vscode "$(node_image)" sh -c \
		'find . -name node_modules -prune -o -name .git -prune -o -type f \( -name package.json -o -name package-lock.json -o -name .npmrc \) -print | tar -cf - -T - | tar -xf - -C /out'
	cp "$ROOT/build/linux/lock-fill.mjs" "$locks/.seclab-lock-fill.mjs"
	key="$(cd "$locks" && find . -type f | LC_ALL=C sort | xargs shasum -a 256 | shasum -a 256 | cut -c1-16)"
	img="seclab-npm-cache:$key"
	if ! docker image inspect "$img" >/dev/null 2>&1; then
		gh cfs doctor --auth >/dev/null 2>&1 || { echo "build: GitHub CFS authentication failed; run 'az login', then 'gh cfs doctor --auth'" >&2; exit 1; }
		echo "build: fetching npm packages through GitHub CFS ($img)" >&2
		mkdir -p "$ROOT/.work/logs"
		# Plain progress to a log (the RUN's own messages never print the token); on failure,
		# show only the step's output lines.
		if ! gh cfs -- docker build --progress plain -t "$img" -f "$ROOT/build/linux/Dockerfile.npm-fetch" "$locks" > "$ROOT/.work/logs/npm-fetch.log" 2>&1; then
			grep -E '^#[0-9]+ [0-9]+\.[0-9]+ ' "$ROOT/.work/logs/npm-fetch.log" | tail -15 >&2
			echo "build: CFS fetch failed (full log: .work/logs/npm-fetch.log)" >&2
			exit 1
		fi
	fi
	docker run --rm --network none -v "$vol:/work" "$img" sh -c 'rm -rf /work/.npm-cache /work/.npm-locks-filled && cp -a /npm-cache /work/.npm-cache && cp -a /locks-filled /work/.npm-locks-filled && chown -R 1001:1001 /work/.npm-cache /work/.npm-locks-filled'
	prune_superseded_images
}

# Remove our images no worktree's build references any more (clean-host's rule), so tagged
# snapshots (npm caches of ~2.3 GB, tool content tags) don't pile up. Best effort, local only.
prune_superseded_images() {
	[[ -n "${CI:-}" ]] && return 0
	"${SECLAB_NODE:-node}" "$ROOT/test/clean-host.ts" --superseded-images >/dev/null 2>&1 || true
}

# The 7-day rule (EDR pin-age-cooldown): no register pin younger than the feed's hold. Network.
# GITHUB_TOKEN (CI) only raises the GitHub API rate limit. npm publish dates: CI reads the public
# registry (its only transport); locally they come from the CFS feed via `gh cfs -- npm view`
# (gh cfs injects the credential; it is never in argv or logs). No fallback to npmjs.
lint_pin_age() {
	local dates="" name version t
	if [[ -z "${CI:-}" ]]; then
		mkdir -p "$ROOT/.work"
		dates="$ROOT/.work/pin-age-npm-dates.json"
		printf '{}' > "$dates"
		local pins
		pins="$(git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/pin-age.ts --list-npm -)"
		if [[ -n "$pins" ]]; then
			gh cfs doctor --auth >/dev/null 2>&1 || { echo "pin-age: npm pins are dated through GitHub CFS, and CFS auth failed: run 'az login', then 'gh cfs doctor --auth'" >&2; exit 1; }
			while read -r name version; do
				[[ "$name" =~ ^(@[a-z0-9._-]+/)?[a-z0-9._-]+$ && "$version" =~ ^[0-9A-Za-z.+-]+$ ]] || { echo "pin-age: bad npm pin $name $version" >&2; exit 1; }
				t="$(gh cfs -- npm view "$name" time --json 2>/dev/null | jq -r --arg v "$version" '.[$v] // empty')" || t=""
				jq --arg k "$name@$version" --arg t "$t" 'if $t == "" then . else .[$k] = $t end' "$dates" > "$dates.new" && mv "$dates.new" "$dates"
			done <<<"$pins"
		fi
	fi
	git -C "$ROOT" ls-files -z | docker run -i --rm -e GITHUB_TOKEN -e CI -v "$ROOT:/repo:ro" ${dates:+-v "$dates:/npm-dates.json:ro"} -w /repo "$(node_image)" \
		node build/pin-age.ts "$@" ${dates:+--npm-dates /npm-dates.json} -
}

# Every command but the hook's own warns when this worktree isn't pushing through the gate (R23-1).
[[ "${1:-}" == hooks ]] || hooks_warn
case "${1:-help}" in
	build)
		shift
		case "${1:-}" in
			linux) shift; build_linux "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	template)
		shift
		case "${1:-}" in
			sbx) shift; "$ROOT/sandbox/sbx/build-template.sh" "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	test)
		shift
		case "${1:-}" in
			# Scratch dirs on a named volume: Docker Desktop's bind-mount inode numbers are not
			# stable, which trips tabd's (dev, ino) workspace identity check.
			unit) docker run --rm -v "$ROOT:/repo" -v seclab-test-scratch:/repo/.work/test-scratch -w /repo "$(node_image)" \
				sh -c 'chown "$(id -u)" .work/test-scratch 2>/dev/null; node --test tabd/test/unit.test.ts tabd/test/supervisor.test.ts tabd/test/obs.test.ts tabd/test/writeback.test.ts tabd/test/writeback-feed.test.ts tabd/test/inspect.test.ts tabd/test/broker-control.test.ts tabd/test/broker-supervisor.test.ts tabd/test/broker-image.test.ts build/patch-reach-imports.test.ts test/agentic/gate/gate.test.ts test/agentic/gate/marks.test.ts build/linux/nm-keep.test.ts build/linux/lock-fill.test.ts build/secret-rules/secret-rules.test.ts' ;;
			# e2e drives sbx/docker on the host, so it runs on the host. It uses the editor's own
			# Node when SECLAB_NODE points at it, else an already-present node (nothing is installed).
			e2e) shift; "${SECLAB_NODE:-node}" "$ROOT/tabd/test/e2e.ts" "${1:-sbx}" ;;
			# A tab with a real broker (plan tabd-broker-wiring B1 OCI, B2 sbx): egress only through it.
			e2e-broker) shift; "${SECLAB_NODE:-node}" "$ROOT/tabd/test/e2e-broker.ts" "$@" ;;
			containment) shift; "${SECLAB_NODE:-node}" "$ROOT/test/containment/run.ts" "${1:-sbx}" ;;
			# RPC-probe safety guards (pure; in the pinned node container, no network).
			probe-safety) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node test/containment/probe-safety.test.ts ;;
			# Test build variants: the harness's hook check and the variant manifest (pure; no network).
			builds) docker run --rm --network none -v "$ROOT:/repo:ro" -v seclab-test-scratch:/scratch -e SECLAB_SCRATCH=/scratch -w /repo "$(node_image)" node test/builds/require-hooks.ts --self-test ;;
			# RPC filter: generated UriComponents argument positions are constrained (pure; no network).
			uri-constraint) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node test/containment/uri-constraint.test.ts ;;
			canary) shift; "${SECLAB_NODE:-node}" "$ROOT/test/canary/run.ts" "${1:-sbx}" ;;
			secrets) shift; "${SECLAB_NODE:-node}" "$ROOT/test/secrets/run.ts" "${1:-sbx}" ;;
			evidence) shift; "${SECLAB_NODE:-node}" "$ROOT/test/containment/check-evidence.ts" "$@" ;;
			obs) shift; "${SECLAB_NODE:-node}" "$ROOT/test/observability/run.ts" "${1:-sbx}" ;;
			# The probe runner's probes, driven into the REAL upstream agent-host client in a
			# network-less container. Each probe must reach what it claims before any run can
			# read its absence as containment.
			probes) shift; "$ROOT/test/agentic/ahp/validate-probes.sh" "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	tab)
		shift
		case "${1:-}" in
			# Reads the supervisor's log files on the host (read-only; no supervisor connection).
			logs) shift; "${SECLAB_NODE:-node}" "$ROOT/tabd/tools/tab-logs.ts" "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	image)
		shift
		case "${1:-}" in
			oci) shift; "$ROOT/sandbox/oci/build-images.sh" "$@"; prune_superseded_images ;;
			*) usage; exit 2 ;;
		esac ;;
	fetch)
		shift
		case "${1:-}" in
			macos) shift; fetch_macos "$@" ;;
			# A dispatched build of a non-main branch, for testing unlanded patches. Never released.
			macos-branch) shift; [[ $# -eq 1 ]] || { usage; exit 2; }; FETCH_BRANCH_BUILD=1 fetch_macos "$1" ;;
			macos-*) v="${1#macos-}"; shift; [[ $# -eq 1 ]] || { usage; exit 2; }; fetch_test_variant "$v" "$1" ;;
			*) usage; exit 2 ;;
		esac ;;
	lint)
		shift
		case "${1:-}" in
			fixtures) shift
				"$ROOT/test/safety/fixture-lint.sh" "$@"
				if [[ $# -eq 0 ]]; then # whole tree: also the repo-wide AV-signature pass (file list on stdin)
					git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node test/safety/fixture-lint.ts --av -
				fi ;;
			pins) shift
				if [[ "${1:-}" == --self-test ]]; then
					docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/check-pins.ts --self-test
				else
					git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/check-pins.ts -
				fi ;;
			workflows) lint_workflows ;;
			secrets) shift; lint_secrets "${1:-}" "${2:-HEAD}" ;;
			# Dependency register (ADR supply-chain provenance): every pin registered, entries complete.
			deps) shift
				if [[ "${1:-}" == --self-test ]]; then
					docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/deps.ts --self-test
				else
					git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/deps.ts check -
				fi ;;
			source) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/check-source.ts ;;
			# Internal identifiers (build/check-denylist.ts): the whole tracked tree, plus any run-record
			# dir passed with --extra. The list never lives in the repo: a private developer file
			# (SECLAB_DENYLIST_FILE, default ~/.config/seclab/denylist.txt, chmod 600), mounted
			# read-only; a missing or loose list fails closed. CI reads it from a secret
			# (build/ci-denylist.sh). Matches print file:line, never text. `lint publish` runs this as
			# its last layer.
			denylist) shift
				if [[ "${1:-}" == --self-test ]]; then
					docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/check-denylist.ts --self-test
				else
					# shellcheck source=build/hooks/publish-gate.sh
					. "$ROOT/build/hooks/publish-gate.sh"
					list="$(publish_gate_list_path)"
					publish_gate_list_ok "$list" || exit 1
					git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" --mount "type=bind,src=$list,dst=/denylist.txt,readonly" -w /repo "$(node_image)" node build/check-denylist.ts check - --list /denylist.txt --require-list "$@"
				fi ;;
			# The publish gate (EDR publish-gate) over the whole committed tree at HEAD, with the
			# live repository check; --self-test injects a hit for every layer (no network).
			publish) shift
				if [[ "${1:-}" == --self-test ]]; then
					docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/publish-gate.ts --self-test
				elif [[ "${1:-}" == --mount-test ]]; then
					"$ROOT/build/test-publish-mount.sh"
				else
					docker image inspect "$(node_image)" >/dev/null 2>&1 || docker pull -q "$(node_image)" >/dev/null
					# shellcheck source=build/hooks/publish-gate.sh
					. "$ROOT/build/hooks/publish-gate.sh"
					publish_gate "$(node_image)" "$ROOT/build" "$(cd "$(git -C "$ROOT" rev-parse --git-common-dir)" && pwd -P)" \
						"$(publish_gate_list_path)" '' -- \
						git-tree --git-dir /git --ref "$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)" "$(git -C "$ROOT" rev-parse HEAD)"
				fi ;;
			# Single-file container mounts cover their entry's imports (build/import-closure.ts).
			mounts) docker run --rm --network none --tmpfs /scratch -e SECLAB_SCRATCH=/scratch -v "$ROOT:/repo:ro" -w /repo "$(node_image)" sh -ec "
				node build/import-closure.ts --self-test
				node build/import-closure.ts build/verify-image.ts -- ${VERIFY_IMAGE_FILES[*]}
				node build/import-closure.ts build/deps-outdated.ts -- ${DEPS_OUTDATED_FILES[*]}
				node build/import-closure.ts build/liveness/liveness.ts -- ${LIVENESS_VERIFY_FILES[*]}" ;;
			# The 7-day rule (EDR pin-age-cooldown): no register pin younger than the feed's hold. Network;
			# GITHUB_TOKEN (CI) only raises the GitHub API rate limit.
			pin-age) shift; lint_pin_age "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	docs)
		shift
		case "${1:-}" in
			write) docker run --rm --network none -u "$(id -u):$(id -g)" -v "$ROOT:/repo" -w /repo "$(node_image)" sh -c 'node tabd/tools/gen-obs-docs.ts write && node build/docs/findings.ts write && node build/docs/docs-check.ts write && node build/deps.ts write' ;;
			check) shift; docs_check "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	findings)
		shift
		if [[ "${1:-}" == remap ]]; then
			[[ $# -eq 3 && "$2" == --branch ]] || { usage; exit 2; }
			findings_remap "$3"; exit $?
		fi
		[[ $# -eq 1 ]] || { usage; exit 2; }
		case "$1" in
			# Every rotted citation, touched or not (the weekly listing's strict view).
			rot) list="$(docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts shas)" || exit 1
				findings_shas 1 <<<"$list" && echo "findings: no rotted citation" ;;
			--self-test) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts --self-test
				findings_host_self_test ;;
			baseline) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/findings.ts baseline ;;
			check) findings_check ;;
			*) usage; exit 2 ;;
		esac ;;
	help|-h|--help) usage ;;
	# Pinned tools (build/tools/tools.json): verify and build; prints the local image tag.
	tool) shift; [[ $# -eq 1 ]] || { usage; exit 2; }; tool_image "$1"; prune_superseded_images ;;
	# Repo-provided git hooks (AGENTS.md). Installed into the clone's common git dir, outside every
	# worktree, so a branch can't weaken or drop the hook by editing build/hooks (review VV-4);
	# re-run after build/hooks changes. Shared by every worktree of this clone.
	hooks) shift
		if [[ "${1:-}" == check ]]; then
			# Is the active hook the locked gate hook this clone's installer wrote? Exit 1 if not.
			problems="$(hooks_problems)"
			if [[ -z "$problems" ]]; then
				echo "hooks: ok (gate hook from main $(sed -n 2p "$(hooks_dir)/.installed" | cut -c1-12), locked)"
				exit 0
			fi
			printf 'hooks: %s\n' "$problems" >&2
			echo "hooks: reinstall with main's code (AGENTS.md)" >&2
			exit 1
		fi
		[[ "${1:-}" == install ]] || { usage; exit 2; }
		hookdir="$(cd "$(git -C "$ROOT" rev-parse --git-common-dir)" && pwd -P)/seclab-hooks"
		gl="$(tool_image gitleaks)" || { echo "hooks: no scanner (./seclab tool gitleaks)" >&2; exit 1; }
		gl_id="$(docker image inspect -f '{{.Id}}' "$gl")"
		gl_arch="$(docker image inspect -f '{{.Architecture}}' "$gl")"
		# The binary's pin comes from main (R20-4): the hook checks the image's gitleaks against it.
		gl_sha="$(git -C "$ROOT" cat-file blob origin/main:build/tools/tools.json | awk -v a="\"$gl_arch\":" '/"gitleaks":/{g=1} g && $1==a {gsub(/[",]/,"",$2); print $2; exit}')"
		[[ "$gl_id" == sha256:* && "$gl_sha" =~ ^[0-9a-f]{64}$ ]] || { echo "hooks: can't resolve the pinned scanner ($gl_arch)" >&2; exit 1; }
		# The template, like the gate it runs, comes from main (R19-5).
		hook="$(git -C "$ROOT" cat-file blob origin/main:build/hooks/pre-push)" \
			|| { echo "hooks: origin/main has no build/hooks/pre-push" >&2; exit 1; }
		[[ "$hook" == *@NODE_IMAGE@* ]] || { echo "hooks: origin/main's pre-push has no publish gate yet; land it first" >&2; exit 1; }
		hook="${hook//@GITLEAKS_IMAGE@/$gl_id}"
		hook="${hook//@GITLEAKS_SHA256@/$gl_sha}"
		# The publish gate (EDR publish-gate): the engine and driver are copied next to the hook and
		# pinned by sha256, so the hook runs no code from whichever checkout pushes. Every pushed
		# tip must carry the allowlist, so refuse to install until main has it (AGENTS.md: never
		# install a shared hook that depends on code that isn't on main yet).
		git -C "$ROOT" cat-file -e "origin/main:build/publish-allow.json" 2>/dev/null \
			|| { echo "hooks: origin/main has no build/publish-allow.json yet; land the publish gate first" >&2; exit 1; }
		# The image the gate runs in is main's pin, not this checkout's (R20-4).
		main_node="$(git -C "$ROOT" cat-file blob origin/main:seclab | sed -n 's/^[[:space:]]*echo "\(node:[^"]*@sha256:[0-9a-f]\{64\}\)"$/\1/p' | head -1)"
		[[ -n "$main_node" ]] || { echo "hooks: can't read the node image pin from origin/main:seclab" >&2; exit 1; }
		[[ "$main_node" == "$(node_image)" ]] || echo "hooks: note: this checkout's node image differs from origin/main's; installing main's" >&2
		for f in seclab build/tools/tools.json build/tools/tool.sh; do
			git -C "$ROOT" diff --quiet origin/main -- "$f" || echo "hooks: note: $f here differs from origin/main" >&2
		done
		docker image inspect "$main_node" >/dev/null 2>&1 || docker pull -q "$main_node" >/dev/null
		node_id="$(docker image inspect -f '{{.Id}}' "$main_node")"
		[[ "$node_id" == sha256:* ]] || { echo "hooks: can't resolve the node image" >&2; exit 1; }
		# The hook directory is kept read-only between installs, so an installer that writes there
		# (every one since the hook moved into the git dir) fails instead of downgrading the shared
		# hook for every worktree. The chmods are inline, not sourced from this checkout (R23-4), and
		# the directory is re-locked however the install ends (R23-3).
		[[ ! -d "$hookdir" ]] || chmod -R u+w "$hookdir"
		trap '[[ -d "$hookdir" ]] && chmod -R a-w "$hookdir"' EXIT INT TERM
		mkdir -p "$hookdir/publish-gate.tmp"
		# From main's objects, not the working tree (R19-5): a branch checked out for testing must
		# not become every worktree's gate.
		for f in build/publish-gate.ts build/check-denylist.ts build/hooks/publish-gate.sh; do
			git -C "$ROOT" cat-file blob "origin/main:$f" >"$hookdir/publish-gate.tmp/${f##*/}" \
				|| { echo "hooks: origin/main has no $f; land the publish gate first" >&2; exit 1; }
			git -C "$ROOT" diff --quiet origin/main -- "$f" \
				|| echo "hooks: note: $f here differs from origin/main; installing main's" >&2
		done
		sums="$(cd "$hookdir/publish-gate.tmp" && shasum -a 256 publish-gate.ts check-denylist.ts)"
		driver_sha="$(shasum -a 256 <"$hookdir/publish-gate.tmp/publish-gate.sh" | cut -d' ' -f1)"
		rm -rf "$hookdir/publish-gate" && mv "$hookdir/publish-gate.tmp" "$hookdir/publish-gate"
		hook="${hook//@NODE_IMAGE@/$node_id}"
		hook="${hook//@GATE_SUMS@/$sums}"
		hook="${hook//@DRIVER_SHA256@/$driver_sha}"
		mkdir -p "$hookdir"
		printf '%s\n' "$hook" > "$hookdir/pre-push.tmp" && chmod 0755 "$hookdir/pre-push.tmp" && mv "$hookdir/pre-push.tmp" "$hookdir/pre-push"
		# The marker the hook checks itself against on every run: its own sha256, then main's commit.
		marker_sha="$(sha256_of "$hookdir/pre-push")"
		[[ "$marker_sha" =~ ^[0-9a-f]{64}$ ]] || { echo "hooks: can't hash the hook (sha256sum or shasum needed)" >&2; exit 1; }
		printf '%s\n%s\n' "$marker_sha" "$(git -C "$ROOT" rev-parse origin/main)" >"$hookdir/.installed"
		git -C "$ROOT" config core.hooksPath "$hookdir"
		chmod -R a-w "$hookdir"
		# shellcheck source=build/hooks/publish-gate.sh
		. "$ROOT/build/hooks/publish-gate.sh"
		publish_gate_list_ok "$(publish_gate_list_path)" 2>/dev/null \
			|| echo "hooks: WARNING: no private known-names list at $(publish_gate_list_path) yet; every push will be refused until it exists (chmod 600; AGENTS.md)" >&2
		# Read back what git will use here: a per-worktree core.hooksPath shadows the shared one (R23-2).
		problems="$(hooks_problems)"
		[[ -z "$problems" ]] || { printf 'hooks: installed, but pushes from here are not gated: %s\n' "$problems" >&2; exit 1; }
		echo "hooks: core.hooksPath=$hookdir (self-contained pre-push: gitleaks ${gl_id:7:12}, publish gate on node ${node_id:7:12}; locked)" ;;
	# The publish gate by hand: the whole tree at HEAD, or text on stdin before it is posted to
	# GitHub (AGENTS.md: run it on every PR/issue body, comment and release note first).
	scan-text)
		docker image inspect "$(node_image)" >/dev/null 2>&1 || docker pull -q "$(node_image)" >/dev/null
		# shellcheck source=build/hooks/publish-gate.sh
		. "$ROOT/build/hooks/publish-gate.sh"
		rc=0
		publish_gate "$(node_image)" "$ROOT/build" "$ROOT/build/publish-allow.json" "$(publish_gate_list_path)" '' -- text || rc=$?
		case "$rc" in
			0) echo "scan-text: clean; it may be posted" >&2 ;;
			3) echo "scan-text: review the flagged lines (no quote, paraphrase or excerpt of a private conversation) before posting" >&2 ;;
			*) echo "scan-text: do not post this text" >&2 ;;
		esac
		exit "$rc" ;;
	print-node-image) node_image ;;
	# Liveness gate (EDR liveness-gate): everything that only matters if something runs it names
	# what runs it, with evidence it ran. Offline with no token, except --verify-runs, which reads
	# the named Actions runs (network; GITHUB_TOKEN with actions: read, in CI).
	liveness)
		shift
		case "${1:-}" in
			--self-test) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/liveness/liveness.ts --self-test ;;
			check)
				[[ $# -eq 1 ]] || { usage; exit 2; }
				git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/liveness/liveness.ts check - ;;
			# The only networked, token-holding step: it sees the register and the checker, nothing
			# else (KKK-4; `lint mounts` keeps the list exact).
			verify-runs) mount_files "${LIVENESS_VERIFY_FILES[@]}" "${LIVENESS_VERIFY_DATA[@]}"
				[[ $# -le 2 ]] || { usage; exit 2; }
				case "${2:-}" in ""|--refresh) ;; *) usage; exit 2 ;; esac
				docker run --rm -e GITHUB_TOKEN -e GITHUB_REPOSITORY "${MOUNTS[@]}" -w /d "$(node_image)" node build/liveness/liveness.ts verify-runs ${2:+"$2"} ;;
			# No log file: nothing recorded a mark (mounting a missing path would create a directory).
			marks) [[ $# -eq 3 ]] || { usage; exit 2; }
				local_log=()
				[[ -f "$3" ]] && local_log=(-v "$3:/liveness.log:ro")
				docker run --rm --network none ${local_log[@]+"${local_log[@]}"} -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/liveness/liveness.ts marks "$2" /liveness.log ;;
			*) usage; exit 2 ;;
		esac ;;
	# CFS feed config (build/cfs-config.ts): the real feed URLs live only in a host-side file
	# outside the repo; the tree holds example values. `config` writes it (host: gh, az, pip3).
	cfs)
		shift
		case "${1:-}" in
			config) "${SECLAB_NODE:-node}" "$ROOT/build/cfs-config.ts" write ;;
			check) "${SECLAB_NODE:-node}" "$ROOT/build/cfs-config.ts" check ;;
			--self-test) docker run --rm --network none -u "$(id -u):$(id -g)" -e HOME=/tmp/home -v "$ROOT:/repo:ro" -w /repo \
				"$(node_image)" sh -c 'mkdir -p "$HOME" && node build/cfs-config.ts --self-test' ;;
			*) usage; exit 2 ;;
		esac ;;
	# Dependency updates Dependabot can't see (ADR supply-chain provenance): report only.
	deps)
		shift
		case "${1:-}" in
			# Only the listed scripts and the register: no repo content or run state in a networked container (EE-2).
			outdated) mount_files "${DEPS_OUTDATED_FILES[@]}" "${DEPS_OUTDATED_DATA[@]}"
				case "${2:-}" in
					--self-test) docker run --rm --network none "${MOUNTS[@]}" -w /d "$(node_image)" node build/deps-outdated.ts --self-test ;;
					"") docker run --rm "${MOUNTS[@]}" -w /d "$(node_image)" node build/deps-outdated.ts ;;
					*) usage; exit 2 ;;
				esac ;;
			host) deps_host ;;
			*) usage; exit 2 ;;
		esac ;;
	# Host hygiene: runs on the host (it drives docker/sbx/ps); dry run unless --apply.
	clean-host) shift
		if [[ "${1:-}" == --self-test ]]; then
			docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node test/clean-host.ts --self-test
		else
			"${SECLAB_NODE:-node}" "$ROOT/test/clean-host.ts" "$@"
		fi ;;
	*) usage; exit 2 ;;
esac
