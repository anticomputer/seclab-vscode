#!/usr/bin/env bash
# seclab: one entry point for the build and dev loop. Runs only docker/sbx/gh on the
# host; all toolchains live in containers or on GitHub Actions.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT="$ROOT/.work/out"

usage() {
	cat <<'EOF'
usage: ./seclab <command>
  build linux [reh|editor ...]  Build Linux REH (default) and/or editor in containers -> .work/out/
                                (editor needs >= 12 GB Docker memory: esbuild peaks ~5 GB RSS)
  template sbx                  Build the sbx tab template (shell kit + REH) -> seclab-tab:local
  image oci                     Build the OCI tab images (seclab-tab-oci:local, broker placeholder)
  test unit                     seclab-tabd unit tests (in a node container)
  test e2e [sbx|oci]            seclab-tabd end-to-end against a real runtime (local)
  test containment [sbx|oci]    Containment suite: malicious-workspace vectors inside real tabs
  test canary [sbx|oci]         Canary acceptance test: no host secret observable from a tab
  test secrets [sbx|oci]        Pre-mount secret scan (gitleaks) gate, move-to-vault, restore
  test obs [sbx|oci]            Tab observability: inert loader -> expected events and labels; sensor tampering -> gap
  tab logs [-f] [--format text|json|falco] [--min PRIORITY] [--state-dir DIR] <tabId|all>
                                Read a tab's observability log (default: the editor's state dir)
  test evidence prepare|check DIR [sbx|oci]
                                Editor-driven run (rogue extension, editor-side canaries)
  lint fixtures [PATH...]       Fixture-safety lint (no real secrets/hosts/persistence in test payloads)
  lint source                   Shipped sources: no unreviewed env/spawn sites, no dynamic loading, no test markers
  docs write                    Regenerate the ADR/EDR/security-review indexes from the records
  docs check [--run-commands] [--online] [--paired]
                                Docs drift gate: records, generated indexes, links, permalinks, ARCHITECTURE
                                consistency; --run-commands runs <!-- ci: run --> blocks (and the broker's);
                                --online resolves external links (lychee, cached); --paired enforces doc
                                changes next to protocol/patch/provider/product changes vs origin/main
  fetch macos [RUN_ID]          Download the unsigned macOS app from Actions -> .work/app/
  clean-host [--apply] [--running] [--caches]
                                List (dry run) or remove every seclab resource on this host: sandboxes,
                                containers, networks, volumes, test profiles, stray test editors/tabd.
                                Never touches other sandboxes (e.g. copilot-*)
  help                          This text
EOF
}

LYCHEE_IMAGE="lycheeverse/lychee@sha256:eaff3e0a13603c9a701accfcc84f44158bb77bf36ecfa4622b626056c3463892" # 0.24.2
ACTIONLINT_IMAGE="rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667"
ZIZMOR_IMAGE="ghcr.io/zizmorcore/zizmor:1.32.0@sha256:3014cc8f68f663935f69b3c3e0e41f5ce102b268d97db13db0f62208747f860d"

# Workflow static analysis (EDR ci-hardening): actionlint, then zizmor. zizmor's online
# audits (impostor commits, ref confusion, known-vulnerable actions) need GH_TOKEN; without
# it they are skipped (CI passes the read-only token on pushes).
lint_workflows() {
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$ACTIONLINT_IMAGE" -no-color
	local online=(--offline)
	[[ -n "${GH_TOKEN:-}" ]] && online=(-e GH_TOKEN)
	if [[ "${online[0]}" == --offline ]]; then
		docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$ZIZMOR_IMAGE" --offline --no-progress --persona=regular .github/workflows
	else
		docker run --rm -e GH_TOKEN -v "$ROOT:/repo:ro" -w /repo "$ZIZMOR_IMAGE" --no-progress --persona=regular .github/workflows
	fi
}

docs_check() {
	local run=0 online=0 paired=0
	for a in "$@"; do
		case "$a" in
			--run-commands) run=1 ;; --online) online=1 ;; --paired) paired=1 ;;
			*) usage; exit 2 ;;
		esac
	done
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/docs-check.ts check
	docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node tabd/tools/gen-obs-docs.ts check
	if [[ -d "$ROOT/broker" ]]; then
		[[ -f "$ROOT/broker/docs-check.sh" ]] || { echo "docs-check: broker/ exists but broker/docs-check.sh is missing" >&2; exit 1; }
		if [[ $run = 1 ]]; then bash "$ROOT/broker/docs-check.sh" --run-commands; else bash "$ROOT/broker/docs-check.sh"; fi
	fi
	if [[ $paired = 1 ]]; then
		local base f
		# CI passes the exact base (PR base SHA, or the push's previous head); locally: origin/main.
		# A force-pushed branch's previous head no longer exists: fall back to the merge base
		# with origin/main, which covers every commit on the branch (stricter, not looser).
		base="${DOCS_BASE:-}"
		if [[ -z "$base" || "$base" =~ ^0+$ ]] || ! git -C "$ROOT" cat-file -e "$base^{commit}" 2>/dev/null; then
			[[ -n "$base" && ! "$base" =~ ^0+$ ]] && echo "docs-check: paired base $base not available; using merge-base with origin/main" >&2
			base="$(git -C "$ROOT" merge-base origin/main HEAD)"
		fi
		git -C "$ROOT" cat-file -e "$base^{commit}" || { echo "docs-check: paired base $base not available (shallow clone?)" >&2; exit 1; }
		f="$ROOT/.work/docs-paired.txt"
		mkdir -p "$ROOT/.work"
		{ git -C "$ROOT" diff --name-only "$base"..HEAD; echo '--'; git -C "$ROOT" log --format='%(trailers:key=docs-not-needed,valueonly)' "$base"..HEAD; } > "$f"
		docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/docs-check.ts paired .work/docs-paired.txt
	fi
	if [[ $online = 1 ]]; then
		# External links and permalinks must resolve; results are cached (named volume) so CI isn't flaky.
		local tok=()
		[[ -n "${GITHUB_TOKEN:-}" ]] && tok=(-e GITHUB_TOKEN)
		docker run --rm ${tok[@]+"${tok[@]}"} -v "$ROOT:/input:ro" -v seclab-lychee-cache:/cache -w /cache "$LYCHEE_IMAGE" \
			--no-progress --cache --max-cache-age 3d --max-concurrency 8 --accept 200,206,429 \
			--exclude-path /input/.work --exclude-path /input/vscode --exclude-path /input/node_modules \
			--exclude '^https?://([^/]+\.)?(test|invalid|example|localhost)(/|:|$)' --exclude '^https?://(127\.|localhost|host\.docker\.internal)' \
			--exclude '^vscode-remote:' --exclude '^https://github\.com/anticomputer/seclab-vscode' \
			'/input/**/*.md'
	fi
	if [[ $run = 1 ]]; then
		docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/docs/docs-check.ts commands > "$ROOT/.work/docs-commands.sh"
		(cd "$ROOT" && bash -e .work/docs-commands.sh)
	fi
}

node_image() {
	# Same Node major as upstream's .nvmrc; used for tests so the host needs no toolchain.
	echo "node:24.22.1-trixie@sha256:f1e034976f948cf212ef1f659c12e5dd58ac7eab947831813e81a62401ca38be"
}

fetch_macos() {
	local run="${1:-}"
	local dest="$ROOT/.work/app"
	local repo="anticomputer/seclab-vscode"
	if [[ -z "$run" ]]; then
		# Only builds of main triggered by a push (reviewed code), never dispatch/PR runs.
		run="$(gh run list -R "$repo" --workflow build-macos.yml --branch main --event push --status success --limit 1 --json databaseId --jq '.[0].databaseId')"
	fi
	[[ "$run" =~ ^[0-9]+$ ]] || { echo "no successful build-macos run on main found" >&2; exit 1; }
	local meta
	meta="$(gh run view -R "$repo" "$run" --json headBranch,event,conclusion,workflowName,headSha --jq '[.headBranch,.event,.conclusion,.workflowName,.headSha]|join(" ")')"
	read -r branch event conclusion workflow head_sha <<<"$meta"
	if [[ "$workflow" != "build-macos" || "$conclusion" != "success" || "$branch" != "main" || "$event" != "push" ]]; then
		echo "refusing run $run: $meta (only successful main push builds are released)" >&2; exit 1
	fi
	[[ "$head_sha" =~ ^[0-9a-f]{40}$ ]] || { echo "bad head SHA $head_sha" >&2; exit 1; }
	# The commit itself must have passed the gates, not just been built (CI-1): the required
	# checks (ci-unit, workflow-lint, docs-check) succeeded on this exact SHA.
	local c ok
	for c in unit lint docs; do
		# Latest attempt per check name (a re-run leaves the failed attempt as its own run).
		ok="$(gh api --paginate "repos/$repo/commits/$head_sha/check-runs?per_page=100" --jq ".check_runs[] | select(.name == \"$c\" and .app.slug == \"github-actions\") | [.id, .conclusion] | @tsv" \
			| sort -n | tail -1 | cut -f2)"
		[[ "$ok" == success ]] || { echo "refusing $head_sha: required check '$c' has not succeeded on it" >&2; exit 1; }
	done
	# Download into a private staging dir; verify there; extract only after re-hashing (CI-3).
	mkdir -p "$ROOT/.work"
	local stage
	stage="$(mktemp -d "$ROOT/.work/app-staging.XXXXXX")"
	chmod 700 "$stage"
	trap 'rm -rf "$stage"' RETURN
	gh run download -R "$repo" "$run" --name seclab-vscode-darwin-arm64 --dir "$stage/dl"
	# Integrity of the download (same artifact)...
	(cd "$stage/dl" && shasum -a 256 -c SHA256SUMS)
	# ...and provenance, before anything is extracted or run: signed by this repo's
	# build-macos workflow on a GitHub-hosted runner, from main at that commit (EDR ci-hardening).
	local f
	for f in seclab-vscode-darwin-arm64.zip build-info.json; do
		gh attestation verify "$stage/dl/$f" -R "$repo" \
			--signer-workflow "$repo/.github/workflows/build-macos.yml" \
			--source-ref "refs/heads/main" --source-digest "$head_sha" --deny-self-hosted-runners >/dev/null \
			|| { echo "provenance verification failed for $f; not extracting" >&2; exit 1; }
	done
	echo "provenance verified: $repo build-macos.yml @ main $head_sha"
	# shellcheck source=/dev/null
	. "$ROOT/upstream.lock"
	jq -e --arg u "$UPSTREAM_SHA" --arg h "$head_sha" '.upstreamSha == $u and .repoSha == $h' "$stage/dl/build-info.json" >/dev/null \
		|| { echo "build-info.json does not match upstream.lock / run head SHA" >&2; exit 1; }
	(cd "$stage/dl" && shasum -a 256 -c SHA256SUMS >/dev/null) || { echo "artifact changed after verification" >&2; exit 1; }
	ditto -x -k "$stage/dl/seclab-vscode-darwin-arm64.zip" "$stage/app"
	cp "$stage/dl/build-info.json" "$stage/dl/SHA256SUMS" "$stage/app/"
	rm -rf "$dest" && mv "$stage/app" "$dest"
	cat "$dest/build-info.json"
	echo
	grep seclab-vscode-darwin-arm64.zip "$dest/SHA256SUMS"
	echo "Unsigned app extracted to $dest. Gatekeeper will block it until quarantine is cleared;"
	echo "that step needs your explicit approval:  xattr -dr com.apple.quarantine \"$dest/seclab-vscode.app\""
}

build_linux() {
	local targets="${*:-reh}"
	mkdir -p "$OUT"
	docker build -q -t seclab-builder:local "$ROOT/build/linux" >/dev/null
	# Durable named volume for the upstream checkout + node_modules (not /tmp, not the Mac FS).
	docker volume create seclab-vscode-work >/dev/null
	docker run --rm -u 0 -v seclab-vscode-work:/work seclab-builder:local chown builder:builder /work
	docker run --rm \
		-v "$ROOT:/repo:ro" \
		-v seclab-vscode-work:/work \
		-v "$OUT:/out" \
		-e TARGETS="$targets" -e ARCH -e MAX_OLD_SPACE_SIZE -e GOGC \
		seclab-builder:local bash /repo/build/linux/build.sh
}

case "${1:-help}" in
	build)
		shift
		case "${1:-}" in
			linux) shift; build_linux "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	template)
		shift
		case "${1:-}" in
			sbx) shift; "$ROOT/sandbox/sbx/build-template.sh" "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	test)
		shift
		case "${1:-}" in
			# Scratch dirs on a named volume: Docker Desktop's bind-mount inode numbers are not
			# stable, which trips tabd's (dev, ino) workspace identity check.
			unit) docker run --rm -v "$ROOT:/repo" -v seclab-test-scratch:/repo/.work/test-scratch -w /repo "$(node_image)" \
				sh -c 'chown "$(id -u)" .work/test-scratch 2>/dev/null; node --test tabd/test/unit.test.ts tabd/test/supervisor.test.ts tabd/test/obs.test.ts tabd/test/writeback.test.ts' ;;
			# e2e drives sbx/docker on the host, so it runs on the host. It uses the editor's own
			# Node when SECLAB_NODE points at it, else an already-present node (nothing is installed).
			e2e) shift; "${SECLAB_NODE:-node}" "$ROOT/tabd/test/e2e.ts" "${1:-sbx}" ;;
			containment) shift; "${SECLAB_NODE:-node}" "$ROOT/test/containment/run.ts" "${1:-sbx}" ;;
			# RPC-probe safety guards (pure; in the pinned node container, no network).
			probe-safety) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node test/containment/probe-safety.test.ts ;;
			canary) shift; "${SECLAB_NODE:-node}" "$ROOT/test/canary/run.ts" "${1:-sbx}" ;;
			secrets) shift; "${SECLAB_NODE:-node}" "$ROOT/test/secrets/run.ts" "${1:-sbx}" ;;
			evidence) shift; "${SECLAB_NODE:-node}" "$ROOT/test/containment/check-evidence.ts" "$@" ;;
			obs) shift; "${SECLAB_NODE:-node}" "$ROOT/test/observability/run.ts" "${1:-sbx}" ;;
			*) usage; exit 2 ;;
		esac ;;
	tab)
		shift
		case "${1:-}" in
			# Reads the supervisor's log files on the host (read-only; no supervisor connection).
			logs) shift; "${SECLAB_NODE:-node}" "$ROOT/tabd/tools/tab-logs.ts" "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	image)
		shift
		case "${1:-}" in
			oci) shift; "$ROOT/sandbox/oci/build-images.sh" "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	fetch)
		shift
		case "${1:-}" in
			macos) shift; fetch_macos "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	lint)
		shift
		case "${1:-}" in
			fixtures) shift
				"$ROOT/test/safety/fixture-lint.sh" "$@"
				if [[ $# -eq 0 ]]; then # whole tree: also the repo-wide AV-signature pass (file list on stdin)
					git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node test/safety/fixture-lint.ts --av -
				fi ;;
			pins) shift
				if [[ "${1:-}" == --self-test ]]; then
					docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/check-pins.ts --self-test
				else
					git -C "$ROOT" ls-files -z | docker run -i --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/check-pins.ts -
				fi ;;
			workflows) lint_workflows ;;
			source) docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node build/check-source.ts ;;
			*) usage; exit 2 ;;
		esac ;;
	docs)
		shift
		case "${1:-}" in
			write) docker run --rm --network none -u "$(id -u):$(id -g)" -v "$ROOT:/repo" -w /repo "$(node_image)" sh -c 'node tabd/tools/gen-obs-docs.ts write && node build/docs/docs-check.ts write' ;;
			check) shift; docs_check "$@" ;;
			*) usage; exit 2 ;;
		esac ;;
	help|-h|--help) usage ;;
	# Host hygiene: runs on the host (it drives docker/sbx/ps); dry run unless --apply.
	clean-host) shift
		if [[ "${1:-}" == --self-test ]]; then
			docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$(node_image)" node test/clean-host.ts --self-test
		else
			"${SECLAB_NODE:-node}" "$ROOT/test/clean-host.ts" "$@"
		fi ;;
	*) usage; exit 2 ;;
esac
