diff --git a/src/vs/platform/windows/electron-main/backgroundWindowsGuard.ts b/src/vs/platform/windows/electron-main/backgroundWindowsGuard.ts
new file mode 100644
index 0000000..02f6036
--- /dev/null
+++ b/src/vs/platform/windows/electron-main/backgroundWindowsGuard.ts
@@ -0,0 +1,132 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { app, BaseWindow, BrowserWindow, dialog, type MessageBoxOptions, type OpenDialogOptions, type SaveDialogOptions, type WebContents } from 'electron';
+import { backgroundWindows } from './windows.js';
+
+// seclab: in background mode (SECLAB_BACKGROUND_WINDOWS=1), nothing in the main process may
+// activate the app or raise a window over the user's work. Call-site guards (windowImpl, the
+// native host) cover what VS Code calls directly; this covers Electron itself, where activation
+// hides: on macOS NativeWindowMac::Show() and WebContents::Focus() (via owner_window->Focus(true))
+// both call activateIgnoringOtherApps, and a dialog without a parent window runs app-modal.
+// And the user's own clicks: showInactive orders a window in front of the user's windows
+// without activating the app, so the user's next click on that spot landed on it and the
+// WindowServer made the editor frontmost (2026-11-06, seen in the unified log as
+// PostFilteredEventTapData "Making ... the front process"). So every window is click-through,
+// and dialogs (sheets are separate windows a click can reach) give their safe answer instead.
+// If it can't be installed, the process exits: an unguarded background run is not allowed.
+
+type Fn = (...args: unknown[]) => unknown;
+
+function replace(target: object, name: string, make: (orig: Fn) => Fn): void {
+	const orig = (target as Record<string, unknown>)[name];
+	if (typeof orig !== 'function') {
+		throw new Error(`background windows guard: ${name} is not a function`);
+	}
+	(target as Record<string, unknown>)[name] = make(orig as Fn);
+	if ((target as Record<string, unknown>)[name] === orig) {
+		throw new Error(`background windows guard: could not replace ${name}`);
+	}
+}
+
+/** A window of ours has keyboard focus: the user activated the app, so focus calls are theirs. */
+function appActive(): boolean {
+	return BrowserWindow.getFocusedWindow() !== null;
+}
+
+export function installBackgroundWindowsGuard(): void {
+	if (!backgroundWindows) {
+		return;
+	}
+	try {
+		for (const proto of [BaseWindow.prototype, BrowserWindow.prototype]) {
+			if (Object.prototype.hasOwnProperty.call(proto, 'show') || proto === BaseWindow.prototype) {
+				replace(proto, 'show', () => function (this: BaseWindow) { this.showInactive(); });
+			}
+			for (const name of ['focus', 'moveTop']) {
+				if (Object.prototype.hasOwnProperty.call(proto, name) || proto === BaseWindow.prototype) {
+					replace(proto, name, orig => function (this: BaseWindow, ...args: unknown[]) { return appActive() ? orig.apply(this, args) : undefined; });
+				}
+			}
+			for (const name of ['setFullScreen', 'setSimpleFullScreen']) {
+				if (Object.prototype.hasOwnProperty.call(proto, name) || proto === BaseWindow.prototype) {
+					replace(proto, name, orig => function (this: BaseWindow, flag: unknown) { return flag ? undefined : orig.call(this, flag); });
+				}
+			}
+			// Click-through, and nothing can turn it off.
+			if (Object.prototype.hasOwnProperty.call(proto, 'setIgnoreMouseEvents') || proto === BaseWindow.prototype) {
+				replace(proto, 'setIgnoreMouseEvents', orig => function (this: BaseWindow, _ignore: unknown, options?: unknown) { return orig.call(this, true, options); });
+			}
+		}
+		replace(app, 'focus', () => () => undefined);
+		// Every window (workbench and auxiliary) is click-through from creation, before it is
+		// shown. The line on stderr is what the focus probe checks (test/focus/probe.ts).
+		app.on('browser-window-created', (_event, win: BrowserWindow) => {
+			try {
+				win.setIgnoreMouseEvents(true);
+				console.error(`[background windows] window ${win.id} is click-through`);
+			} catch (error) {
+				console.error(String(error));
+				app.exit(1);
+			}
+		});
+
+		// WebContents has no exported class: patch its prototype from the first instance. A failure
+		// here must stop the app too, not just log (review AAA-2). DevTools open with
+		// `activate: true` by default and focus natively, past the focus patch (AAA-1).
+		let patched = false;
+		app.on('web-contents-created', (_event, contents: WebContents) => {
+			if (patched) {
+				return;
+			}
+			patched = true;
+			try {
+				const proto = Object.getPrototypeOf(contents);
+				const origFocus = proto.focus;
+				replace(proto, 'focus', orig => function (this: WebContents) { return appActive() ? orig.call(this) : undefined; });
+				// Docked, never detached: a detached DevTools window is created natively, not as a
+				// BrowserWindow, so it would escape click-through (review FFF-1).
+				replace(proto, 'openDevTools', orig => function (this: WebContents, options?: unknown) {
+					return orig.call(this, { ...(options && typeof options === 'object' ? options : {}), mode: 'bottom', activate: false });
+				});
+				replace(proto, 'toggleDevTools', () => function (this: WebContents) {
+					return this.isDevToolsOpened() ? this.closeDevTools() : this.openDevTools({ mode: 'bottom', activate: false });
+				});
+				if (contents.focus === origFocus) {
+					throw new Error('background windows guard: WebContents.focus not replaced');
+				}
+			} catch (error) {
+				console.error(String(error));
+				app.exit(1);
+			}
+		});
+
+		// Dialogs: never shown (a sheet is its own window, which a click can reach, and an app-
+		// modal one activates the app). Each gives its safe answer: a message box its cancelId
+		// (VS Code always sets one; review AAA), a file dialog "canceled". Logged on stderr.
+		const cancelled = (name: string, options: { cancelId?: number; message?: unknown } | undefined) => {
+			// One line per dialog: the message may be tab text (a remote extension's modal), so no
+			// control or line-separator character can start a forged guard line (review FFF-2).
+			console.error(`[background windows] dialog not shown (${name}): ${String(options?.message ?? '').replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]/g, ' ').slice(0, 200)}`);
+			return name.startsWith('showMessageBox') ? { response: options?.cancelId ?? 0, checkboxChecked: false } : { canceled: true, filePaths: [], filePath: '' };
+		};
+		const optionsOf = (a: unknown, b?: unknown) => (a instanceof BaseWindow ? b : a) as MessageBoxOptions & OpenDialogOptions & SaveDialogOptions;
+		for (const name of ['showMessageBox', 'showOpenDialog', 'showSaveDialog']) {
+			replace(dialog, name, () => (a: unknown, b?: unknown) => Promise.resolve(cancelled(name, optionsOf(a, b))));
+		}
+		for (const name of ['showMessageBoxSync', 'showOpenDialogSync', 'showSaveDialogSync']) {
+			replace(dialog, name, () => (a: unknown, b?: unknown) => {
+				const c = cancelled(name, optionsOf(a, b));
+				return 'response' in c ? c.response : undefined;
+			});
+		}
+		replace(dialog, 'showErrorBox', () => (title: unknown, content: unknown) => {
+			console.error(`[background windows] error box suppressed: ${String(title)}: ${String(content)}`);
+		});
+	} catch (error) {
+		console.error(String(error));
+		app.exit(1);
+	}
+}
