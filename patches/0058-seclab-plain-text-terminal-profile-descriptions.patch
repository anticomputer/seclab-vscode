+import { escapeMarkdownSyntaxTokens } from '../../../base/common/htmlContent.js';
 
+/**
+ * seclab: these descriptions render as markdown in the trusted window's Settings editor, and in a
+ * tab window the profiles come from the tab's REH and the contributed ones from its extensions, so
+ * a name or path could carry an image the window fetches. The text is escaped and the icon must be
+ * a codicon id (patch 0058, review R5-15).
+ */
+function seclabText(value: unknown): string {
+	return escapeMarkdownSyntaxTokens(String(value));
+}
+function seclabIconId(icon: unknown): string {
+	const id = ThemeIcon.isThemeIcon(icon) ? icon.id : icon;
+	return isString(id) && /^[a-z0-9-]+(~[a-z0-9-]+)?$/i.test(id) ? id : Codicon.terminal.id;
+}
