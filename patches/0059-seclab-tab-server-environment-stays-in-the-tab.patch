 import { IRemoteAgentConnection, IRemoteAgentService } from './remoteAgentService.js';
+import { IChannel } from '../../../../base/parts/ipc/common/ipc.js';
+import { Event } from '../../../../base/common/event.js';
+import { seclabIsTabAuthority, seclabRefuseServerLocation, seclabTabUri } from '../../extensions/common/seclabRpcFilter.js';
 
+/**
+ * seclab: a tab's server reports file changes by resource; in a tab window one outside the tab's
+ * own file system (a host file) is dropped and logged, so the window never re-reads or prompts on
+ * a host file because the tab said it changed. A kept resource is rebuilt from its components
+ * (patch 0059, reviews ENV-5, ENV-9).
+ */
+function seclabTabWatcherChannel(channel: IChannel, remoteAuthority: string): IChannel {
+	if (!seclabIsTabAuthority(remoteAuthority)) {
+		return channel;
+	}
+	return {
+		call: (command, arg, token) => channel.call(command, arg, token),
+		listen: <T>(event: string, arg?: unknown): Event<T> => event !== 'fileChange' ? channel.listen<T>(event, arg) : (listener, thisArgs, disposables) => channel.listen<T>(event, arg)(e => {
+			if (Array.isArray(e)) {
+				const own = e.flatMap(c => {
+					const resource = seclabTabUri(remoteAuthority, (c as { resource?: unknown } | null)?.resource);
+					return resource ? [{ ...(c as object), resource }] : [];
+				});
+				if (own.length !== e.length) {
+					seclabRefuseServerLocation(remoteAuthority, 'watcher');
+				}
+				listener.call(thisArgs, own as T);
+			} else {
+				listener.call(thisArgs, e);
+			}
+		}, undefined, disposables),
+	};
+}
