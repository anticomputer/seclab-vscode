+import { IChannel } from '../../../../base/parts/ipc/common/ipc.js';
+import { Event } from '../../../../base/common/event.js';
+import { seclabIsTabAuthority, seclabRefuseServerLocation, seclabTabUris } from '../../extensions/common/seclabRpcFilter.js';
 
+/**
+ * seclab: the profiles a tab's server reports, in its replies and its change events, name where the
+ * window keeps that tab's settings, extensions and MCP config. In a tab window each location must be
+ * on the tab's own file system: a reply naming another is refused, an event dropped, both logged
+ * (patch 0059, review ENV-3).
+ */
+function seclabTabProfilesChannel(channel: IChannel, remoteAuthority: string): IChannel {
+	if (!seclabIsTabAuthority(remoteAuthority)) {
+		return channel;
+	}
+	const check = <T>(v: T): T => {
+		try {
+			return seclabTabUris(remoteAuthority, v);
+		} catch (e) {
+			seclabRefuseServerLocation(remoteAuthority, 'profiles');
+			throw e;
+		}
+	};
+	return {
+		call: async <T>(command: string, arg?: unknown, token?: Parameters<IChannel['call']>[2]) => check(await channel.call<T>(command, arg, token)),
+		listen: <T>(event: string, arg?: unknown): Event<T> => (listener, thisArgs, disposables) => channel.listen<T>(event, arg)(e => {
+			let checked: T;
+			try {
+				checked = check(e);
+			} catch {
+				return;
+			}
+			listener.call(thisArgs, checked);
+		}, undefined, disposables),
+	};
+}
