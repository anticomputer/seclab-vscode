+/**
+ * seclab: a tab's server names where the window keeps that tab's settings, storage, logs and
+ * profiles, and the window then reads and writes those files as the tab's own. In a `seclab+`
+ * window every URI in the reply must be on the tab's own file system (`vscode-remote` on this
+ * window's authority, which a genuine server's URI transformer always produces); one that isn't,
+ * such as the host user's settings file, refuses the whole environment and the connection fails
+ * (patch 0059, review R5-17). Fail closed: anything nested too deep to check counts as foreign.
+ */
+function seclabCheckEnvironment(remoteAuthority: string, data: unknown): void {
+	if (!seclabIsTabAuthority(remoteAuthority)) {
+		return;
+	}
+	const foreign = (v: unknown, depth: number): boolean => {
+		if (!v || typeof v !== 'object') {
+			return false;
+		}
+		if (depth > 8) {
+			return true;
+		}
+		const u = v as { scheme?: unknown; authority?: unknown; path?: unknown };
+		if (typeof u.scheme === 'string' && typeof u.path === 'string') {
+			return u.scheme !== Schemas.vscodeRemote || u.authority !== remoteAuthority;
+		}
+		return Object.values(v).some(x => foreign(x, depth + 1));
+	};
+	if (foreign(data, 0)) {
+		seclabRefuseEnvironment(remoteAuthority);
+		throw new Error('seclab: the tab\'s server named a location outside the tab; its environment is refused');
+	}
+}
