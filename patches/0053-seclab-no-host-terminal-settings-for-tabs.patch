diff -ruN a/src/vs/workbench/contrib/terminal/common/seclabTabTerminalSettings.ts b/src/vs/workbench/contrib/terminal/common/seclabTabTerminalSettings.ts
--- a/src/vs/workbench/contrib/terminal/common/seclabTabTerminalSettings.ts	1969-12-31 19:00:00
+++ b/src/vs/workbench/contrib/terminal/common/seclabTabTerminalSettings.ts	2026-11-18 23:36:54
@@ -0,0 +1,58 @@
+/*---------------------------------------------------------------------------------------------
+ *  seclab: the terminal settings a `seclab+` window sends its tab (patch 0053, reviews DOCSYNC-R5,
+ *  RFU1R-2, RFU1R2-1). The settings read here are all registered `restricted`, so patch 0036
+ *  never lets a host value of theirs reach the tab's extension host; the window must not send
+ *  them to the tab's REH or extension host by another path either. Dependency-free: this file is
+ *  in the REH bundle too, which must not load the RPC filter module.
+ *--------------------------------------------------------------------------------------------*/
+
+import { UriComponents } from '../../../../base/common/uri.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IWorkspace } from '../../../../platform/workspace/common/workspace.js';
+
+/** The filter module's tab test, `seclabIsTabAuthority`: the prefix in any case (review R5-21). */
+export function seclabIsTabWindow(remoteAuthority: string | null | undefined): boolean {
+	return typeof remoteAuthority === 'string' && /^seclab\+/i.test(remoteAuthority);
+}
+
+/** A resource on the tab's own file system: `vscode-remote` on the window's authority, in any case. */
+export function seclabUriInTab(uri: UriComponents | null | undefined, remoteAuthority: string): boolean {
+	return !!uri && uri.scheme === 'vscode-remote' && typeof uri.authority === 'string' && uri.authority.toLowerCase() === remoteAuthority.toLowerCase();
+}
+
+const isMap = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
+
+/** Upstream's merge of one configuration layer over another: maps merge key by key, recursively. */
+function merge(base: unknown, over: unknown): unknown {
+	if (!isMap(base) || !isMap(over)) {
+		return over;
+	}
+	const out: Record<string, unknown> = Object.create(null);
+	for (const k of Object.keys(base)) {
+		out[k] = base[k];
+	}
+	for (const k of Object.keys(over)) {
+		out[k] = merge(out[k], over[k]);
+	}
+	return out;
+}
+
+/** Whether the workspace's settings are the tab's (patch 0036's test): its file, or else every folder, on the tab. */
+export function seclabWorkspaceInTab(workspace: IWorkspace, remoteAuthority: string): boolean {
+	return workspace.configuration
+		? seclabUriInTab(workspace.configuration, remoteAuthority)
+		: workspace.folders.every(f => seclabUriInTab(f.uri, remoteAuthority));
+}
+
+/**
+ * `key` from the layers the tab owns: the defaults, the REH's remote user settings and, when the
+ * workspace is the tab's own (patch 0036's test: its workspace file, or else every folder, on the
+ * tab's authority), the workspace and folder settings. Never the host user's, application or
+ * policy values, or a host-side workspace's.
+ */
+export function seclabTabSetting<T>(configurationService: IConfigurationService, workspace: IWorkspace, remoteAuthority: string, key: string): T | undefined {
+	const v = configurationService.inspect<T>(key);
+	const workspaceInTab = seclabWorkspaceInTab(workspace, remoteAuthority);
+	const layers: unknown[] = [v.defaultValue, v.userRemoteValue, ...(workspaceInTab ? [v.workspaceValue, v.workspaceFolderValue] : [])];
+	return layers.filter(l => l !== undefined).reduce(merge, undefined) as T | undefined;
+}
