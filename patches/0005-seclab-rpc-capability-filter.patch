+		// from its own window's authority and tabd stamps the time, so neither
+		// can be influenced by anything the tab chose.
+		return out.length > SECLAB_LOG_LINE_MAX
+			? out.slice(0, SECLAB_LOG_LINE_MAX) : out;
+	};
