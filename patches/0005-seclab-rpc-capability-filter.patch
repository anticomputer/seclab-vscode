--- a/src/vs/workbench/services/extensions/common/seclabRpcFilter.ts	1969-12-31 19:00:00
+++ b/src/vs/workbench/services/extensions/common/seclabRpcFilter.ts	2026-11-06 18:50:32
@@ -0,0 +1,991 @@
+/*---------------------------------------------------------------------------------------------
+ *  seclab-vscode: RPC capability filter.
+ *
+ *  Design and rationale: docs/RPC-LOCKDOWN.md. Policy table: rpc-filter/policy/policy.json.
+ *
+ *  A tab's sandbox contains the code it runs. It does not contain the tab's
+ *  ability to ask the trusted side to act on its behalf, and the sandbox is
+ *  pointless if the tab can ask the workbench to open a host terminal and type
+ *  into it. This is the choke point that closes that.
+ *--------------------------------------------------------------------------------------------*/
+
+import { setSeclabChannelGuard } from '../../../../base/parts/ipc/common/ipc.js';
+import { URI } from '../../../../base/common/uri.js';
+import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
+import { RawContextKey } from '../../../../platform/contextkey/common/contextkey.js';
+import {
+	SECLAB_CHANNELS, SECLAB_COMMANDS, SECLAB_DEFAULT_VERDICT, SECLAB_RPC,
+	SECLAB_COMMAND_DENY_PREFIXES, SECLAB_SERVICE_DEFAULTS, SECLAB_TRUSTED_COMMAND_IDS, SECLAB_URI_ARGS,
+	type SeclabEntry, type SeclabVerdict,
+} from './seclabPolicyData.js';
+import { seclabValidate, type SeclabValidatorContext } from './seclabArgValidators.js';
+
+/**
+ * Window state some validators read. Supplied by whoever builds the filter (the extension
+ * host manager); absent, the validators that need it fail closed.
+ */
+export interface SeclabFilterServices {
+	readonly contextKeys?: { getContextKeyValue(key: string): unknown };
+}
+
+/** Authorities we filter. Anything else is either local-trusted or unknown. */
+const SECLAB_AUTHORITY = /^seclab\+/;
+
+/** A context value no tab ever set: what an unreadable context key reports. */
+const SECLAB_UNKNOWN_VALUE: unknown = Object.freeze({});
+
+/**
+ * Revive as the consumer will, and say whether the result is canonical. `URI.revive` takes
+ * `external` and `fsPath` from the wire as the URI's cached string and path (on macOS
+ * `_pathSepMarker` is undefined, so a missing `_sep` matches), so a URI with this tab's
+ * scheme and authority could carry a host `fsPath` that every consumer of `fsPath` or
+ * `toString()` would use. No extension host produces one; a validator refuses it.
+ */
+function seclabReviveUri(raw: unknown): { readonly uri: URI; readonly canonical: boolean } | undefined {
+	try {
+		const uri = URI.revive(raw as never);
+		const canonical = URI.from({ scheme: uri.scheme, authority: uri.authority, path: uri.path, query: uri.query, fragment: uri.fragment });
+		return { uri, canonical: uri.toString() === canonical.toString() && uri.fsPath === canonical.fsPath };
+	} catch {
+		return undefined;
+	}
+}
+
+export interface SeclabDenial {
+	readonly ref: string;
+	readonly tabId: string;
+	readonly reason: string;
+	readonly at: number;
+}
+
+/**
+ * One filter decision, in the shape agreed with the tab-observability session.
+ *
+ * `id` is the wire sid for the `rpc` surface, not the MainContext property
+ * name: seven diverge, so mapping from the property name mislabels those.
+ *
+ * `claimedExtensionId` is exactly that -- a claim. Extension identity arrives
+ * as an RPC *argument* (`$getPassword(extensionId, key)` is the canonical
+ * case), so a hostile host names whatever it likes. It must never be used for
+ * authorization, and a UI must present it as "claims to be X".
+ */
+export interface SeclabDecision {
+	readonly surface: 'rpc' | 'cmd' | 'chan' | 'data';
+	readonly id: string;
+	readonly ref: string;
+	readonly tabId: string;
+	readonly verdict: SeclabVerdict;
+	readonly reason?: string;
+	readonly constraint?: string;
+	readonly claimedExtensionId?: string;
+	/** Aggregated allows: how many were collapsed into this event. */
+	readonly count?: number;
+	readonly at: number;
+}
+
+type SeclabDecisionListener = (d: SeclabDecision) => void;
+
+const seclabListeners = new Set<SeclabDecisionListener>();
+
+/** Window over which permitted decisions are collapsed, as agreed: 10s. */
+const SECLAB_AGGREGATE_MS = 10_000;
+const seclabPending = new Map<string, { decision: SeclabDecision; count: number; timer: unknown }>();
+
+export function seclabOnDecision(listener: SeclabDecisionListener): { dispose(): void } {
+	seclabListeners.add(listener);
+	return { dispose: () => { seclabListeners.delete(listener); } };
+}
+
+function seclabDeliver(d: SeclabDecision): void {
+	for (const l of seclabListeners) {
+		try {
+			l(d);
+		} catch {
+			// A broken listener must never break the filter.
+		}
+	}
+}
+
+/**
+ * Every verdict is collapsed per (surface, id, verdict). Denials used to be
+ * delivered individually, on the reasoning that they are what an investigator
+ * acts on -- but an investigator acts on the *first* one, and the repeats are
+ * what drowned the log. See the proof run
+ * (docs/edr/20261106-rpc-core-proof-run.md): 4932 copies of one denied line in
+ * 666 ms of ordinary startup, with no attacker involved.
+ *
+ * So a first-seen key is delivered immediately, and repeats within the window
+ * are collapsed into one follow-up carrying `count`. Nothing is lost and the
+ * line rate is bounded by the number of distinct keys, not by call volume.
+ */
+/**
+ * Proof that the filter that enforces this policy table is in the build.
+ *
+ * `build/prepare.sh` stamps `product.json` with
+ * `seclabRpcPolicy.sha256 = sha256(seclabPolicyData.ts)`, which shows the table
+ * was *applied*. It cannot show that anything *reads* it -- a build could carry
+ * the table and no enforcement and stamp identically. So the enforcing side
+ * carries the same hash, and a consumer requiring both has evidence that the
+ * table present is the table being enforced.
+ *
+ * The hash is of `seclabPolicyData.ts`, a *different* file, deliberately: a
+ * marker inside the file whose hash it carries would be its own fixed point.
+ * `emit_policy.py` writes this line and `--check` fails when it drifts, so it
+ * cannot be edited to agree with a table it does not describe.
+ *
+ * Referenced at install (see `seclabInstallDecisionLog`) rather than merely
+ * exported, so bundling and minification cannot drop it as dead code. That is
+ * the whole point: an unreferenced string is exactly what a tree-shaker
+ * removes, and the marker would then be missing from the one artefact the
+ * consumer inspects.
+ *
+ * Written as ONE literal, never `'seclabRpcFilterEnforcing:' + SHA`.
+ * `build/check-release.sh` scans the built JavaScript for the folded string, so
+ * a concatenation that a bundler declines to fold is absent from the artefact
+ * and fails the release check on a build that is in fact correct. The whole
+ * line is generated by `emit_policy.py`, which is also why it is not typed.
+ */
+export const SECLAB_ENFORCING_MARKER = 'seclabRpcFilterEnforcing:4447f3e87f2972e779ae6a6f442799c422d5eff78c91396ce9850beff57d6a7f';
+
+/** Max bytes for one log line, and for the tab-chosen `ref` inside it. */
+const SECLAB_LOG_LINE_MAX = 4096;
+/**
+ * `ref` is tab-chosen for an unmatched method (`rpc:<sid>.<method>`) and for
+ * every `cmd:` id. 1024 let ~512 calls spend the whole byte budget. No real
+ * surface or command id is anywhere near 256.
+ */
+const SECLAB_LOG_REF_MAX = 256;
+/**
+ * The byte budget is per rolling window and is **never latched off**: at the
+ * end of each window it refills, and a suppressed run is summarised rather
+ * than silently dropped. The previous design latched `capped` forever on the
+ * first window that overran, so one noisy second silenced the window for its
+ * whole life -- which is the property the log exists to deny a tab.
+ */
+const SECLAB_LOG_WINDOW_MS = 60_000;
+const SECLAB_LOG_BYTES_PER_WINDOW = 512 * 1024;
+/**
+ * A key never logged before is always written, even over budget, so a flood of
+ * one key can never hide the *first* occurrence of another -- which is exactly
+ * what proof condition 2 needs. Bounded so a tab cannot grow the set without
+ * limit by inventing method names; past the bound, first-seen loses its
+ * reservation and the budget alone applies.
+ */
+const SECLAB_LOG_KEYS_MAX = 4096;
+
+let seclabLogInstalled = false;
