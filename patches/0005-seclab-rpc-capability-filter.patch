+			? 'warning' : d.verdict === 'rewrite' ? 'notice' : 'informational';
+		const out = JSON.stringify({
+			source: 'rpc-filter', class: 'rpc.decision', priority,
+			summary: `${d.verdict} ${d.surface}`, detail,
+		});
