@@ -169,6 +169,34 @@
 	}
 
 	// return as is
+	return error;
+}
+
+/**
+ * seclab: `error` as it may cross to a sandboxed tab. Name, message, code and cause are kept; the
+ * stack is only its first line, because a host stack names the app's path, the user's home and the
+ * code that refused a call (review AIP-4). Another object loses any `stack`; the original is never
+ * changed, so host-side logs keep the detail.
+ */
+export function seclabErrorForTab(error: unknown, depth = 0): unknown {
+	if (error instanceof Error) {
+		const clean = new Error(error.message);
+		clean.name = error.name;
+		clean.stack = error.message ? `${error.name}: ${error.message}` : `${error.name}`;
+		if ((<ErrorWithCode>error).code !== undefined) {
+			(<ErrorWithCode>clean).code = (<ErrorWithCode>error).code;
+		}
+		if (error.cause !== undefined && depth < 8) {
+			clean.cause = seclabErrorForTab(error.cause, depth + 1);
+		}
+		return clean;
+	}
+	if (error && typeof error === 'object' && ('stack' in error || 'stacktrace' in error)) {
+		const rest = { ...(error as Record<string, unknown>) };
+		delete rest.stack;
+		delete rest.stacktrace;
+		return rest;
+	}
 	return error;
 }
 
