+/**
+ * seclab: `error` as it may cross to a sandboxed tab. An error (or error-like object) keeps its name,
+ * message, code and cause, and its stack is only its first line, because a host stack names the
+ * app's path, the user's home and the code that refused a call (review AIP-4). Any other object
+ * (its `toJSON` first, as JSON would) is copied without a `stack` or `stacktrace`, to a bounded
+ * depth. The original is never changed, so host-side logs keep the detail; anything that can't be
+ * read becomes an unsupported operation.
+ */
+export function seclabErrorForTab(error: unknown, depth = 0): unknown {
+	const bare = (name: string, message: string) => Object.assign(new Error(message), { name, stack: message ? `${name}: ${message}` : name });
+	try {
+		const e = error as { name?: unknown; message?: unknown; stack?: unknown; code?: unknown; cause?: unknown } | null;
+		if (error instanceof Error || (e && typeof e === 'object' && typeof e.stack === 'string' && 'message' in e)) {
+			const clean: Error & { code?: unknown } = bare(String(e!.name ?? 'Error'), String(e!.message ?? ''));
+			if (typeof e!.code === 'string' || typeof e!.code === 'number') {
+				clean.code = e!.code;
+			}
+			if (e!.cause !== undefined && depth < 8) {
+				clean.cause = seclabErrorForTab(e!.cause, depth + 1);
+			}
+			return clean;
+		}
+		if (e && typeof e === 'object') {
+			if (depth >= 8) {
+				return undefined;
+			}
+			// Binary data as bytes only: a view or buffer can carry properties of its own too.
+			if (ArrayBuffer.isView(e)) {
+				return new Uint8Array(e.buffer, e.byteOffset, e.byteLength).slice();
+			}
+			if (e instanceof ArrayBuffer) {
+				return e.slice(0);
+			}
+			// As JSON: `toJSON` once, its result walked but not asked again.
+			const v: unknown = typeof (e as { toJSON?: unknown }).toJSON === 'function' ? (e as { toJSON(): unknown }).toJSON() : e;
+			if (!v || typeof v !== 'object') {
+				return v;
+			}
+			if (Array.isArray(v)) {
+				return v.map(x => seclabErrorForTab(x, depth + 1));
+			}
+			// No `toJSON` is copied: the serialiser would ask it again, after the cleaning (PR review on #78).
+			return Object.fromEntries(Object.entries(v).filter(([k]) => k !== 'stack' && k !== 'stacktrace' && k !== 'toJSON').map(([k, x]) => [k, seclabErrorForTab(x, depth + 1)]));
+		}
+		return error;
+	} catch {
+		return bare('Error', 'Unsupported operation');
+	}
 }
 
