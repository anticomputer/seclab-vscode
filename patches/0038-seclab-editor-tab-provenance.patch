+		uris.push(editor.base, editor.input1.uri, editor.input2.uri, editor.result);
+	}
+	if (editor instanceof InteractiveEditorInput) {
+		uris.push(editor.inputResource);
+	}
+	return uris.filter(URI.isUri);
