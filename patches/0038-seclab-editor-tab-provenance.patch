+/** Every resource an editor shows (seclab, patch 0038): both sides, merge inputs, multi-diff entries. */
+function seclabEditorUris(editor: EditorInput): URI[] {
+	const r = EditorResourceAccessor.getCanonicalUri(editor, { supportSideBySide: SideBySideEditor.BOTH });
+	const uris: unknown[] = URI.isUri(r) ? [r] : [r?.primary, r?.secondary];
+	if (editor instanceof MergeEditorInput) {
+		uris.push(editor.base, editor.input1.uri, editor.input2.uri, editor.result);
+	}
+	if (editor instanceof MultiDiffEditorInput) {
+		uris.push(...(editor.resources.get() ?? []).flatMap(x => [x.originalUri, x.modifiedUri]));
+	}
+	if (editor instanceof InteractiveEditorInput) {
+		uris.push(editor.inputResource);
+	}
+	return uris.filter(URI.isUri);
+}
