diff -ruN a/src/vs/workbench/api/browser/seclabDocumentOrigin.ts b/src/vs/workbench/api/browser/seclabDocumentOrigin.ts
--- a/src/vs/workbench/api/browser/seclabDocumentOrigin.ts	1970-01-01 00:00:00
+++ b/src/vs/workbench/api/browser/seclabDocumentOrigin.ts	2026-11-09 16:59:21
@@ -0,0 +1,124 @@
+/*---------------------------------------------------------------------------------------------
+ *  seclab: which text models belong to a tab's extension host (patch 0035, EDR
+ *  document-sync-provenance). In a `seclab+` window a non-local extension host is sent a model only
+ *  if the tab owns it, decided per model, never per scheme:
+ *  - a file on this window's own tab authority;
+ *  - a model this host's own content provider created (untagged by any other write);
+ *  - a text file served, since the model appeared, by a filesystem provider this host registered;
+ *  - an untitled model this host created, or one that was empty when it appeared;
+ *  - a notebook cell of a notebook on this window's own tab authority.
+ *  Local hosts and other windows are unchanged.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Emitter } from '../../../base/common/event.js';
+import { Schemas } from '../../../base/common/network.js';
+import { ITextModel, shouldSynchronizeModel } from '../../../editor/common/model.js';
+import { IFileService, IFileSystemProvider } from '../../../platform/files/common/files.js';
+import { IExtHostContext } from '../../services/extensions/common/extHostCustomers.js';
+import { ExtensionHostKind } from '../../services/extensions/common/extensionHostKind.js';
+import { ITextFileService } from '../../services/textfile/common/textfiles.js';
+import { CellUri } from '../../contrib/notebook/common/notebookCommon.js';
+
+class SeclabOrigin {
+	readonly models = new WeakSet<ITextModel>();
+	readonly untitled = new WeakSet<object>();
+	readonly fsProviders = new WeakSet<IFileSystemProvider>();
+	readonly onDidChange = new Emitter<void>();
+	writing: ITextModel | undefined;
+	/** Set by MainThreadDocumentsAndEditors: a non-local host in a `seclab+` window. */
+	filtered = false;
+}
+const origins = new WeakMap<IExtHostContext, SeclabOrigin>();
+// What a model was when the window first saw it: every host's predicate records it, at birth (the
+// textfile manager registers its model before the async resolve creates the text model).
+const born = new WeakMap<ITextModel, { empty: boolean; provider: IFileSystemProvider | undefined; textFile: boolean }>();
+
+export function seclabOrigin(ctx: IExtHostContext): SeclabOrigin {
+	let o = origins.get(ctx);
+	if (!o) {
+		origins.set(ctx, o = new SeclabOrigin());
+	}
+	return o;
+}
+
+export function seclabIsFiltered(ctx: IExtHostContext, windowAuthority: string | undefined): boolean {
+	return ctx.extensionHostKind !== ExtensionHostKind.LocalProcess && !!windowAuthority?.startsWith('seclab+');
+}
+
+/** Called right after this host's content provider created `model`. */
+export function seclabTagProvidedModel(ctx: IExtHostContext, model: ITextModel): void {
+	const o = seclabOrigin(ctx);
+	o.models.add(model);
+	// Registered before the model is synced, so it runs before MainThreadDocuments' ModelTracker.
+	const l = model.onDidChangeContent(() => {
+		if (o.writing !== model) {
+			o.models.delete(model);
+			l.dispose();
+			o.onDidChange.fire();
+		}
+	});
+	o.onDidChange.fire();
+}
+
+/** `$onVirtualDocumentChange`: a filtered host may only write to models its own provider made. */
+export function seclabProviderWrite(ctx: IExtHostContext, model: ITextModel, write: () => void): void {
+	const o = seclabOrigin(ctx);
+	if (o.filtered && !o.models.has(model)) {
+		return;
+	}
+	const outer = o.writing;
+	o.writing = model;
+	try {
+		write();
+	} finally {
+		o.writing = outer;
+	}
+}
+
+/** Called with an untitled model this host's call actually created (not one it reopened). */
+export function seclabTagCreatedUntitled(ctx: IExtHostContext, untitled: object): void {
+	seclabOrigin(ctx).untitled.add(untitled);
+}
+
+/** Called when this host registered a filesystem provider (registration fails for a taken scheme). */
+export function seclabTagFsProvider(ctx: IExtHostContext, provider: IFileSystemProvider): void {
+	seclabOrigin(ctx).fsProviders.add(provider);
+}
+
+export function seclabShouldSync(ctx: IExtHostContext, model: ITextModel, windowAuthority: string | undefined, fileService: IFileService, textFileService: ITextFileService): boolean {
+	let b = born.get(model);
+	if (!b) {
+		born.set(model, b = {
+			empty: model.getValueLength() === 0 && !textFileService.untitled.get(model.uri)?.hasAssociatedFilePath,
+			provider: fileService.getProvider(model.uri.scheme),
+			textFile: !!textFileService.files.get(model.uri),
+		});
+	}
+	if (!shouldSynchronizeModel(model) || !seclabIsFiltered(ctx, windowAuthority)) {
+		return shouldSynchronizeModel(model);
+	}
+	const o = seclabOrigin(ctx);
+	const uri = model.uri;
+	if (o.models.has(model)) {
+		return true;
+	}
+	if (uri.scheme === Schemas.vscodeRemote) {
+		return uri.authority === windowAuthority;
+	}
+	if (uri.scheme === Schemas.untitled) {
+		const untitled = textFileService.untitled.get(uri);
+		return !!untitled && (o.untitled.has(untitled) || b.empty);
+	}
+	if (uri.scheme === Schemas.vscodeNotebookCell) {
+		try {
+			const notebook = CellUri.parse(uri)?.notebook;
+			return notebook?.scheme === Schemas.vscodeRemote && notebook.authority === windowAuthority;
+		} catch {
+			return false;
+		}
+	}
+	// A text file born under this host's provider. A model born otherwise (host output, say) never
+	// qualifies, even if the tab later takes the scheme or a text file model wraps it.
+	const provider = fileService.getProvider(uri.scheme);
+	return b.textFile && !!provider && b.provider === provider && o.fsProviders.has(provider);
+}
