+		query.set('windowId', String(target.id));
+		const uri = URI.from({ scheme: product.urlProtocol, authority: seclabTabRouter, path: '/open', query: query.toString() });
+		this.logService.info(`[seclab] routed ${routed.length} local folder(s) or workspace(s) to the Tab Manager in window ${target.id}`);
