diff -ruN a/src/vs/workbench/services/configuration/common/seclabTabSettings.ts b/src/vs/workbench/services/configuration/common/seclabTabSettings.ts
--- a/src/vs/workbench/services/configuration/common/seclabTabSettings.ts	1969-12-31 19:00:00
+++ b/src/vs/workbench/services/configuration/common/seclabTabSettings.ts	2026-11-18 21:16:00
@@ -0,0 +1,45 @@
+/*---------------------------------------------------------------------------------------------
+ *  seclab: settings that name the host user's files reach a sandboxed tab only from the tab's own
+ *  layers (patch 0060, review SRCH-3; project owner, 2026-11-18). Wherever the window builds an
+ *  exclude or watcher pattern it sends a tab (a search query, a watch request), the value for a
+ *  folder on the tab comes from the defaults, the tab's remote user settings and the folder's own
+ *  settings, never from the host user's settings, policy, in-memory values or a workspace file.
+ *  Patterns a caller passes are never touched, so what reaches the tab says nothing about the
+ *  host's settings (review SRCH3-4).
+ *--------------------------------------------------------------------------------------------*/
+
+import { Schemas } from '../../../../base/common/network.js';
+import { URI } from '../../../../base/common/uri.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { seclabIsTabAuthority } from '../../extensions/common/seclabRpcFilter.js';
+
+/** Whether `resource` is on a sandboxed tab's file system. */
+export function seclabOnTab(resource: URI | undefined): resource is URI {
+	return !!resource && resource.scheme === Schemas.vscodeRemote && seclabIsTabAuthority(resource.authority);
+}
+
+const isRecord = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
+
+/**
+ * The value of `key` for a tab `resource` from the tab's own layers: objects merge, anything else
+ * takes the last layer that sets it. A single folder's settings are its folder layer as well as
+ * its workspace layer, so the workspace layer (a workspace file's settings) is left out.
+ */
+export function seclabTabOwnValue<T>(configurationService: IConfigurationService, key: string, resource: URI): T | undefined {
+	const i = configurationService.inspect<T>(key, { resource });
+	const own = [i.defaultValue, i.userRemoteValue, i.workspaceFolderValue].filter((v): v is T => v !== undefined);
+	return own.length && own.every(isRecord) ? own.reduce((a, b) => ({ ...a, ...b })) : own[own.length - 1];
+}
+
+/** `config` (a search configuration for `resource`) with its exclude maps from the tab's own layers when `resource` is on a tab. */
+export function seclabWithTabExcludes<C extends { files?: { exclude?: unknown }; search?: { exclude?: unknown } }>(configurationService: IConfigurationService, resource: URI | undefined, config: C): C {
+	if (!seclabOnTab(resource)) {
+		return config;
+	}
+	const own = (key: string) => seclabTabOwnValue<Record<string, unknown>>(configurationService, key, resource) ?? {};
+	return {
+		...config,
+		files: config.files && { ...config.files, exclude: own('files.exclude') },
+		search: config.search && { ...config.search, exclude: own('search.exclude') },
+	};
+}
