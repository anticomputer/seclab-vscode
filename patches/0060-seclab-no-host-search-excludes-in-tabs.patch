diff -ruN a/src/vs/workbench/services/configuration/common/seclabTabSettings.ts b/src/vs/workbench/services/configuration/common/seclabTabSettings.ts
--- a/src/vs/workbench/services/configuration/common/seclabTabSettings.ts	1969-12-31 19:00:00
+++ b/src/vs/workbench/services/configuration/common/seclabTabSettings.ts	2026-11-18 21:02:33
@@ -0,0 +1,68 @@
+/*---------------------------------------------------------------------------------------------
+ *  seclab: settings that name host files reach a sandboxed tab only from the tab's own layers
+ *  (patch 0060, review SRCH-3; project owner, 2026-11-18). The host user's exclude and watcher
+ *  patterns name the host user's own files and folders. Wherever the window sends such a setting
+ *  to a tab (a search query, a watch request), it takes the value from the defaults, the tab's
+ *  remote user settings, and workspace and folder settings whose file is on the tab, never from
+ *  the host user's settings, policy, in-memory values or a workspace file elsewhere.
+ *--------------------------------------------------------------------------------------------*/
+
+import { IExpression } from '../../../../base/common/glob.js';
+import { Schemas } from '../../../../base/common/network.js';
+import { URI } from '../../../../base/common/uri.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { seclabIsTabAuthority } from '../../extensions/common/seclabRpcFilter.js';
+
+/** Whether `resource` is on a sandboxed tab's file system. */
+export function seclabOnTab(resource: URI | undefined): resource is URI {
+	return !!resource && resource.scheme === Schemas.vscodeRemote && seclabIsTabAuthority(resource.authority);
+}
+
+const isRecord = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
+
+/** The layers of `key` for `resource`, split into the tab's own and the host's. */
+function layers<T>(configurationService: IConfigurationService, contextService: IWorkspaceContextService, key: string, resource: URI): { own: T[]; host: T[] } {
+	const i = configurationService.inspect<T>(key, { resource });
+	const ws = contextService.getWorkspace().configuration;
+	const wsOnTab = !ws || (ws.scheme === resource.scheme && ws.authority.toLowerCase() === resource.authority.toLowerCase());
+	const defined = (vs: Array<T | undefined>) => vs.filter((v): v is T => v !== undefined);
+	return {
+		own: defined([i.defaultValue, i.userRemoteValue, wsOnTab ? i.workspaceValue : undefined, i.workspaceFolderValue]),
+		host: defined([i.applicationValue, i.userLocalValue, i.policyValue, i.memoryValue, wsOnTab ? undefined : i.workspaceValue]),
+	};
+}
+
+/** The value of `key` for a tab `resource` from the tab's own layers: objects merge, anything else takes the last layer that sets it. */
+export function seclabTabOwnValue<T>(configurationService: IConfigurationService, contextService: IWorkspaceContextService, key: string, resource: URI): T | undefined {
+	const { own } = layers<T>(configurationService, contextService, key, resource);
+	return own.length && own.every(isRecord) ? own.reduce((a, b) => ({ ...a, ...b })) : own[own.length - 1];
+}
+
+const EXCLUDE_KEYS = ['files.exclude', 'search.exclude'];
+
+/**
+ * `pattern` as a query to a tab may carry it: a pattern any host layer of `files.exclude` or
+ * `search.exclude` sets for these `resources` keeps only the value the tab's own layers give it,
+ * else it goes. Patterns from nowhere else (what the user typed) are unchanged.
+ */
+export function seclabWithoutHostExcludes(configurationService: IConfigurationService, contextService: IWorkspaceContextService, pattern: IExpression, resources: readonly URI[]): IExpression {
+	const host = new Set<string>();
+	const own: IExpression = {};
+	for (const resource of resources) {
+		for (const key of EXCLUDE_KEYS) {
+			const l = layers<IExpression>(configurationService, contextService, key, resource);
+			l.host.filter(isRecord).forEach(v => Object.keys(v).forEach(k => host.add(k)));
+			l.own.filter(isRecord).forEach(v => Object.assign(own, v));
+		}
+	}
+	const out: IExpression = {};
+	for (const [k, v] of Object.entries(pattern)) {
+		if (!host.has(k)) {
+			out[k] = v;
+		} else if (Object.hasOwn(own, k)) {
+			out[k] = own[k];
+		}
+	}
+	return out;
+}
