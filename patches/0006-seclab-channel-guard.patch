+/**
+ * seclab: guard for channels the CLIENT serves to a remote server.
+ *
+ * Under our threat model the REH server process runs inside the tab and is
+ * hostile. It calls these channels directly over the remote connection, so they
+ * never pass through RPCProtocol and a MainThread*-only filter does not see
+ * them at all (docs/RPC-LOCKDOWN.md section 2.4).
+ *
+ * The guard lives on ChannelServer rather than on a convenience wrapper such as
+ * AbstractRemoteAgentService.registerChannel, because that wrapper is a
+ * convention a caller can bypass: anything holding the connection can register
+ * straight on the channelServer, as upstream already does elsewhere. Guarding
+ * the mechanism makes it an invariant instead.
+ *
+ * Installed by the workbench; `ipc.ts` is base-layer and must not import it.
+ */
+export type SeclabChannelGuard = (ctx: unknown, channelName: string, method: string) => Error | undefined;
+
+let seclabChannelGuard: SeclabChannelGuard | undefined;
+
+export function setSeclabChannelGuard(guard: SeclabChannelGuard | undefined): void {
+	seclabChannelGuard = guard;
+}
+
+/**
+ * seclab: is this channel being served to a tab?
+ *
+ * ipc.ts is base-layer and cannot import the workbench, so the test is on the
+ * context the connection supplies: the authority string itself, or an object
+ * carrying `remoteAuthority` (what the management connection passes).
+ */
+function seclabIsTabContext(ctx: unknown): boolean {
+	const a = typeof ctx === 'string'
+		? ctx
+		: (ctx && typeof ctx === 'object' && typeof (ctx as { remoteAuthority?: unknown }).remoteAuthority === 'string')
+			? (ctx as { remoteAuthority: string }).remoteAuthority
+			: '';
+	return a.startsWith('seclab+');
+}
+
+/**
+ * seclab: the verdict when NO guard is installed.
+ *
+ * Previously `undefined`, i.e. allow. The guard is installed by a top-level
+ * side effect in the workbench, which runs only once something imports that
+ * module, so "installed before the hostile server's first channel call" was an
+ * assumption about bundle evaluation order rather than an enforced property --
+ * and the REH inside the tab chooses when to make that call (review round 9
+ * alert 5). A tab context with no guard is now refused.
+ *
+ * Only tab contexts: the trusted side serves channels over this same class
+ * before any tab exists, and refusing those would brick the window.
+ */
+function seclabRefuseUnguarded(...ctxs: unknown[]): Error | undefined {
+	return seclabChannelGuard === undefined && ctxs.some(seclabIsTabContext)
+		? new Error('Unsupported operation')
+		: undefined;
+}
