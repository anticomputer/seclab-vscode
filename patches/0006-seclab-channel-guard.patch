+/**
+ * seclab: guard for channels the CLIENT serves to a remote server.
+ *
+ * Under our threat model the REH server process runs inside the tab and is
+ * hostile. It calls these channels directly over the remote connection, so they
+ * never pass through RPCProtocol and a MainThread*-only filter does not see
+ * them at all (docs/RPC-LOCKDOWN.md section 2.4).
+ *
+ * The guard lives on ChannelServer rather than on a convenience wrapper such as
+ * AbstractRemoteAgentService.registerChannel, because that wrapper is a
+ * convention a caller can bypass: anything holding the connection can register
+ * straight on the channelServer, as upstream already does elsewhere. Guarding
+ * the mechanism makes it an invariant instead.
+ *
+ * Installed by the workbench; `ipc.ts` is base-layer and must not import it.
+ */
+export type SeclabChannelGuard = (ctx: unknown, channelName: string, method: string) => Error | undefined;
+
+let seclabChannelGuard: SeclabChannelGuard | undefined;
+
+export function setSeclabChannelGuard(guard: SeclabChannelGuard | undefined): void {
+	seclabChannelGuard = guard;
+}
+
 export class ChannelServer<TContext = string> implements IChannelServer<TContext>, IDisposable {
 
 	private channels = new Map<string, IServerChannel<TContext>>();
