+/**
+ * seclab: the editor-window agent host service, which refuses to dial in a tab.
+ *
+ * `chat.workspaceRemoteAgentHosts` is WINDOW scope, so a tab supplies it
+ * through workspace settings or through the REH-supplied remote user settings.
+ * The host renderer would then dial that address over the *host* network,
+ * bypassing the broker, and hand the real GitHub token to whatever answered --
+ * the setting's own description says "connected hosts receive your GitHub
+ * credentials". `restricted: true` does not help, because it only withholds a
+ * setting in untrusted workspaces and a tab reports trusted.
+ *
+ * Refusing here, rather than re-scoping the setting, keeps upstream's
+ * per-workspace behaviour in ordinary windows. The check runs on every
+ * reconcile, so it cannot be outrun by a settings change arriving later.
+ */
+export class SeclabEditorWindowRemoteAgentHostService extends EditorWindowRemoteAgentHostService {
+
+	protected override _reconcileConnections(): void {
+		if (seclabAiDisabled(this._seclabEnvironmentService.remoteAuthority)) {
+			return;
+		}
+		super._reconcileConnections();
+	}
+
+	constructor(
+		@IConfigurationService configurationService: IConfigurationService,
+		@IInstantiationService instantiationService: IInstantiationService,
+		@ILogService logService: ILogService,
+		@ILabelService labelService: ILabelService,
+		@IStorageService storageService: IStorageService,
+		@IWorkbenchEnvironmentService private readonly _seclabEnvironmentService: IWorkbenchEnvironmentService,
+	) {
+		super(configurationService, instantiationService, logService, labelService, storageService);
+	}
+}
