+/**
+ * seclab: returns true when this window must not dial a remote agent host.
+ *
+ * Declared by the workbench, which is the only layer that knows the window's
+ * remote authority; `platform/` must not import it.
+ *
+ * **Undeclared means deny.** A guard that defaults to permitting fails open
+ * whenever it is consulted before installation, and service instantiation
+ * order does not guarantee otherwise. Our fork always ships the declaration,
+ * so the only way to reach `_connectTo` undeclared is a bug -- and the safe
+ * answer to a bug here is not to dial. A late declaration can only
+ * over-refuse, never under-refuse.
+ */
+export type SeclabDialPolicy = 'allow' | 'deny';
