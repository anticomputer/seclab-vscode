+	/**
+	 * seclab: in a tab window the profiles come from the tab's REH, so choosing or saving one
+	 * writes the tab's own (remote) settings, never the host user's, which a normal window's next
+	 * terminal would run; and the profiles a write extends are the tab's own, so none of the host
+	 * user's are copied to the tab (patch 0057, review R5-14).
+	 */
+	private _seclabTab(): string | undefined {
+		const window = this._seclabEnvironment.remoteAuthority;
+		return window && seclabIsTabWindow(window) ? window : undefined;
+	}
+	private _seclabTarget(): ConfigurationTarget {
+		return this._seclabTab() ? ConfigurationTarget.USER_REMOTE : ConfigurationTarget.USER;
+	}
+	private _seclabProfiles(key: string): unknown {
+		const tab = this._seclabTab();
+		if (!tab) {
+			return this._configurationService.getValue(key);
+		}
+		// A copy: the caller adds to it, and a layer's own object must not change.
+		const value = seclabTabSetting<object>(this._configurationService, this._seclabWorkspace.getWorkspace(), tab, key);
+		return value && typeof value === 'object' ? { ...value } : value;
+	}
