+registerSingleton(ICloudSandboxModelCatalogService, seclabGuarded('cloudSandboxModelCatalogService', CloudSandboxModelCatalogService), InstantiationType.Delayed);
+registerSingleton(ICloudSandboxAgentHostService, seclabGuarded('cloudSandboxAgentHostService', CloudSandboxAgentHostService), InstantiationType.Delayed);
+registerSingleton(IMissionControlEnvironmentService, seclabGuarded('missionControlEnvironmentService', MissionControlEnvironmentService), InstantiationType.Delayed);
