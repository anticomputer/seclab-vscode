+// seclab patch 0019: in a `seclab+` window none of these providers may exist. They reach an
+// agent host that is not this window's own gated one, and one of the contributions below
+// registers chat agents for a remote connection, which is the only way an agent belonging to
+// another connection enters the window (patch 0018, finding R12-2).
+//
+// `registerSingleton` and `registerWorkbenchContribution2` run at module load, before any
+// service exists, so neither can branch on the window's authority. Both wrappers therefore
+// decide at CONSTRUCTION time, which is the first moment the authority is knowable.
+function seclabGuarded<T>(name: string, real: new (...args: any[]) => T): new (...args: any[]) => T {
+	class SeclabGuardedProvider {
+		constructor(
+			@IWorkbenchEnvironmentService environmentService: IWorkbenchEnvironmentService,
+			@IInstantiationService instantiationService: IInstantiationService,
+		) {
+			if (!isSeclabAuthority(environmentService.remoteAuthority)) {
+				// An ordinary window: the real service, built by the instantiation service so
+				// that its own dependencies are injected exactly as upstream declares them.
+				return instantiationService.createInstance(real as any);
+			}
+			// Emitted, not inferred: a run asserts that this provider resolved to the null one
+			// rather than reading anything into the absence of a connection.
+			seclabAhpEmit(seclabNullProviderEvent(name) as any);
+			const shape = SECLAB_NULL_PROVIDERS.find(p => p.name === name);
+			return seclabNullProvider(shape ?? { name, members: {} }, { constObservable, noEvent: Event.None }) as any;
+		}
+	}
+	return SeclabGuardedProvider as any;
+}
+
