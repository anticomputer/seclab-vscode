{
	"name": "tab-manager",
	"displayName": "seclab Tab Manager",
	"description": "Opens every folder as a sandboxed tab (remote extension host in a per-tab sandbox).",
	"version": "0.1.0",
	"publisher": "seclab",
	"license": "MIT",
	"private": true,
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionKind": [
		"ui"
	],
	"enabledApiProposals": [
		"resolvers"
	],
	"activationEvents": [
		"onResolveRemoteAuthority:seclab",
		"*"
	],
	"main": "./out/extension",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"contributes": {
		"resourceLabelFormatters": [
			{
				"scheme": "vscode-remote",
				"authority": "seclab+*",
				"formatting": {
					"label": "${path}",
					"separator": "/",
					"tildify": true,
					"workspaceSuffix": "Tab",
					"workspaceTooltip": "Sandboxed tab"
				}
			}
		],
		"commands": [
			{
				"command": "seclab.openFolder",
				"title": "Open Folder in New Tab…",
				"category": "seclab"
			},
			{
				"command": "seclab.showLog",
				"title": "Show Tab Manager Log",
				"category": "seclab"
			},
			{
				"command": "seclab.removeTab",
				"title": "Remove Tab…",
				"category": "seclab"
			},
			{
				"command": "seclab.resetTab",
				"title": "Reset This Tab…",
				"category": "seclab",
				"enablement": "remoteName == seclab"
			},
			{
				"command": "seclab.reviewChanges",
				"title": "Review Held Changes…",
				"category": "seclab",
				"enablement": "remoteName == seclab"
			},
			{
				"command": "seclab.confirmDeletes",
				"title": "Confirm Held Deletions…",
				"category": "seclab",
				"enablement": "remoteName == seclab"
			},
			{
				"command": "seclab.activity.focus",
				"title": "Show Tab Activity",
				"category": "seclab"
			},
			{
				"command": "seclab.activity.filter",
				"title": "Filter by Priority…",
				"category": "seclab",
				"icon": "$(filter)"
			},
			{
				"command": "seclab.activity.toggleDetections",
				"title": "Toggle Detections Only",
				"category": "seclab",
				"icon": "$(alert)"
			},
			{
				"command": "seclab.activity.deepMode",
				"title": "Observation Mode…",
				"category": "seclab",
				"icon": "$(telescope)"
			},
			{
				"command": "seclab.detections.refresh",
				"title": "Refresh Detections",
				"category": "seclab",
				"icon": "$(refresh)"
			},
			{
				"command": "seclab.detections.filter",
				"title": "Filter Detections…",
				"category": "seclab",
				"icon": "$(filter)"
			},
			{
				"command": "seclab.detections.stopTab",
				"title": "Stop Tab",
				"category": "seclab",
				"icon": "$(debug-stop)"
			},
			{
				"command": "seclab.detections.openTab",
				"title": "Open Tab",
				"category": "seclab",
				"icon": "$(window)"
			},
			{
				"command": "seclab.detections.blockDestination",
				"title": "Block Destination",
				"category": "seclab",
				"icon": "$(circle-slash)"
			}
		],
		"viewsContainers": {
			"panel": [
				{
					"id": "seclabActivity",
					"title": "Tab Activity",
					"icon": "media/activity.svg"
				}
			]
		},
		"views": {
			"seclabActivity": [
				{
					"id": "seclab.tabActivity",
					"name": "Tab Activity",
					"when": "remoteName == seclab"
				},
				{
					"id": "seclab.detections",
					"name": "Detections (All Tabs)"
				}
			]
		},
		"menus": {
			"view/title": [
				{ "command": "seclab.activity.filter", "when": "view == seclab.tabActivity", "group": "navigation@1" },
				{ "command": "seclab.activity.toggleDetections", "when": "view == seclab.tabActivity", "group": "navigation@2" },
				{ "command": "seclab.activity.deepMode", "when": "view == seclab.tabActivity", "group": "navigation@3" },
				{ "command": "seclab.detections.filter", "when": "view == seclab.detections", "group": "navigation@1" },
				{ "command": "seclab.detections.refresh", "when": "view == seclab.detections", "group": "navigation@2" }
			],
			"view/item/context": [
				{ "command": "seclab.detections.stopTab", "when": "view == seclab.detections && viewItem =~ /Running/", "group": "inline@1" },
				{ "command": "seclab.detections.openTab", "when": "view == seclab.detections && viewItem =~ /^seclab(Tab|Detection)/", "group": "inline@2" },
				{ "command": "seclab.detections.blockDestination", "when": "view == seclab.detections && viewItem == seclabDetectionRunningBlockable", "group": "inline@3" }
			],
			"commandPalette": [
				{ "command": "seclab.detections.stopTab", "when": "false" },
				{ "command": "seclab.detections.openTab", "when": "false" },
				{ "command": "seclab.detections.blockDestination", "when": "false" }
			]
		},
		"keybindings": [
			{
				"command": "seclab.openFolder",
				"key": "ctrl+k ctrl+o",
				"mac": "cmd+o"
			}
		],
		"configuration": {
			"title": "seclab tabs",
			"properties": {
				"seclab.tabs.driver": {
					"type": "string",
					"enum": ["sbx", "oci"],
					"default": "sbx",
					"scope": "application",
					"description": "Sandbox runtime driver for new tabs."
				},
				"seclab.tabs.image": {
					"type": "string",
					"default": "",
					"scope": "application",
					"description": "Tab template image (default: seclab-tab:local for sbx, seclab-tab-oci:local for oci)."
				},
				"seclab.tabs.allowedRoots": {
					"type": "array",
					"items": { "type": "string" },
					"default": [],
					"scope": "application",
					"description": "If set, folders may only be opened as tabs under these absolute paths."
				},
				"seclab.activity.revealOnAlert": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "Show the Tab Activity panel once per tab on its first critical detection, or when the tab becomes unobserved."
				},
				"seclab.tabs.gcDays": {
					"type": "integer",
					"default": 30,
					"minimum": 0,
					"maximum": 3650,
					"scope": "application",
					"description": "Stopped tabs unused for this many days are removed (their sandbox, installed extensions and tab home; never your folder). 0 keeps them forever. Tabs holding moved secrets are never removed."
				}
			}
		}
	}
}
