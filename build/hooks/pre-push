#!/usr/bin/env bash
# pre-push (installed with `./seclab hooks install`; AGENTS.md): every commit range being pushed
# is scanned with the gitleaks built from pinned source before anything leaves the machine.
# A hit, or a scan that can't run (no docker, no scanner), blocks the push.
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# The scanner comes from the pushing checkout; one that predates it can't push (fail closed).
grep -q '^lint_secrets()' "$ROOT/seclab" 2>/dev/null || { echo "pre-push: $ROOT has no ./seclab lint secrets; push from an up-to-date checkout" >&2; exit 1; }
zero='^0+$'
status=0
while read -r _lref lsha _rref rsha; do
	[[ "$lsha" =~ $zero ]] && continue # a delete pushes no content
	# A new remote ref (or one we don't have) scans from the merge base with origin/main.
	base="$rsha"
	if [[ "$base" =~ $zero ]] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
		base="$(git merge-base origin/main "$lsha")"
	fi
	"$ROOT/seclab" lint secrets "$base" "$lsha" || status=1
done
exit "$status"
