+// SECLAB_TEST_ONLY: canary-clipboard hook. Applied only to the `containment` test build
+// variant (test/builds/variants.json), never by patches/series; check-release fails any
+// artifact containing it. Every clipboard call the renderer can make lands here, and in this
+// build none of them touches the system clipboard: they use an in-memory store, seeded with
+// the run's canary (SECLAB_TEST_CLIPBOARD_CANARY, a seclabcanary_ token) when the harness
+// sets one. So a probe that reads the clipboard can only ever see the canary.
+const clipboard = (() => {
+	const seed = process.env['SECLAB_TEST_CLIPBOARD_CANARY'];
+	let text = typeof seed === 'string' && /^seclabcanary_[A-Za-z0-9_]{8,128}$/.test(seed) ? seed : '';
+	let findText = '';
+	const buffers = new Map<string, Buffer>();
+	return {
+		marker: 'SECLAB_TEST_ONLY:canary-clipboard',
+		readText: (_type?: 'selection' | 'clipboard') => text,
+		writeText: (value: string, _type?: 'selection' | 'clipboard') => { text = String(value); },
+		readFindText: () => findText,
+		writeFindText: (value: string) => { findText = String(value); },
+		readImage: () => nativeImage.createEmpty(),
+		writeImage: (_image: unknown) => { },
+		writeBuffer: (format: string, buffer: Buffer, _type?: 'selection' | 'clipboard') => { buffers.set(format, Buffer.from(buffer)); },
+		readBuffer: (format: string) => buffers.get(format) ?? Buffer.alloc(0),
+		has: (format: string, _type?: 'selection' | 'clipboard') => buffers.has(format) || (format === 'text/plain' && text !== ''),
+	};
+})();
