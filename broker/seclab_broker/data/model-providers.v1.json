{
  "$comment": "Built-in model providers for the broker's model-host body policy (broker/seclab_broker/models.py). A policy names one by id in models.providers, or declares its own object. The lists are allowlists: anything not listed is denied. Fields that name remote resources or server-side state (OpenAI web_search_options, Responses prompt/background/conversation, Anthropic mcp_servers/container) are deliberately absent. `copilot` is MEASURED: endpoints, per-endpoint fields and tool types are what the shipped agent host and Copilot runtime sent from a real tab through its broker (secure-agentic B2 run, test/agentic/ahp/tab-spike.ts at c759e5c, 2026-11-05; GHES route, github.com inferred from the same code path). `openai` and `anthropic` remain DRAFTS from the providers' public API references.",
  "providers": [
    {
      "id": "copilot",
      "hosts": ["api.githubcopilot.com", "api.individual.githubcopilot.com", "api.business.githubcopilot.com", "api.enterprise.githubcopilot.com"],
      "endpoints": [
        {"path": "/models", "methods": ["GET"]},
        {"path": "/responses", "methods": ["POST"],
         "fields": ["include", "input", "instructions", "model", "parallel_tool_calls", "reasoning", "store", "stream", "text", "tools"],
         "toolTypes": ["function", "custom"]},
        {"path": "/chat/completions", "methods": ["POST"],
         "fields": ["messages", "model", "reasoning_effort", "snippy", "stream", "stream_options", "temperature", "tools"],
         "toolTypes": ["function", "custom"]},
        {"path": "/v1/messages", "methods": ["POST"],
         "fields": ["max_tokens", "messages", "model", "stream", "system", "temperature", "thinking", "tools"],
         "toolTypes": ["custom"], "untypedTool": "custom"},
        {"id": "github-mcp-readonly", "path": "/mcp/readonly", "methods": ["POST"], "requiresGrant": true,
         "fields": ["id", "jsonrpc", "method", "params"], "toolTypes": []}
      ],
      "fields": [],
      "toolTypes": []
    },
    {
      "id": "openai",
      "hosts": ["api.openai.com"],
      "endpoints": [
        {"path": "/v1/chat/completions", "methods": ["POST"]},
        {"path": "/v1/responses", "methods": ["POST"]},
        {"path": "/v1/models", "methods": ["GET"]},
        {"path": "/v1/embeddings", "methods": ["POST"]}
      ],
      "fields": ["model", "messages", "input", "instructions", "include", "audio", "modalities", "frequency_penalty", "presence_penalty", "logit_bias", "logprobs", "top_logprobs", "max_tokens", "max_completion_tokens", "max_output_tokens", "max_tool_calls", "metadata", "n", "parallel_tool_calls", "prediction", "previous_response_id", "prompt_cache_key", "reasoning", "reasoning_effort", "response_format", "safety_identifier", "seed", "service_tier", "stop", "store", "stream", "stream_options", "temperature", "text", "tool_choice", "tools", "top_p", "truncation", "user", "verbosity", "dimensions", "encoding_format"],
      "toolTypes": ["function"]
    },
    {
      "id": "anthropic",
      "hosts": ["api.anthropic.com"],
      "endpoints": [
        {"path": "/v1/messages", "methods": ["POST"]},
        {"path": "/v1/messages/count_tokens", "methods": ["POST"]},
        {"path": "/v1/models", "methods": ["GET"]}
      ],
      "fields": ["model", "messages", "system", "max_tokens", "metadata", "stop_sequences", "stream", "temperature", "thinking", "tool_choice", "tools", "top_k", "top_p", "service_tier"],
      "toolTypes": ["custom"],
      "untypedTool": "custom"
    }
  ]
}
