{
  "version": 1,
  "tabId": "example-cfs-feeds",
  "baseline": false,
  "prompt": {
    "enabled": true,
    "timeoutSeconds": 60
  },
  "allow": [
    {"id": "cfs-npm", "host": "pkgs.dev.azure.com", "methods": ["GET"], "path": "/example-org/ExampleProject/_packaging/example-npm-feed/npm/registry/**"},
    {"id": "cfs-pypi", "host": "pkgs.dev.azure.com", "methods": ["GET"], "path": "/example-org/ExampleProject/_packaging/example-pypi-feed/pypi/**"}
  ],
  "credentials": [
    {
      "id": "cfs",
      "provider": "azure-devops",
      "inject": {"header": "Authorization", "fmt": "Basic {base64:cfs:{value}}"},
      "bind": [
        {"host": "pkgs.dev.azure.com", "path": "/example-org/ExampleProject/_packaging/example-npm-feed/npm/registry/**", "methods": ["GET"]},
        {"host": "pkgs.dev.azure.com", "path": "/example-org/ExampleProject/_packaging/example-pypi-feed/pypi/**", "methods": ["GET"]}
      ],
      "budget": {"requests": 5000, "bytes": 2147483648}
    }
  ]
}
