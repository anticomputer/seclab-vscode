{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/anticomputer/seclab-vscode/broker/schema/policy.v1.schema.json",
  "title": "seclab-vscode broker policy, version 1",
  "description": "Per-tab egress and credential policy. Engine-agnostic: it names hosts, ports, schemes, methods and paths, never engine internals. Default is deny.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "tabId": { "$ref": "#/definitions/id" },
    "baseline": {
      "type": "boolean",
      "default": true,
      "description": "Merge the broker's built-in baseline allow rules (extension gallery)."
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "timeoutSeconds": { "type": "number", "minimum": 0.1, "maximum": 600, "default": 60 },
        "maxPending": { "type": "integer", "minimum": 1, "maximum": 256, "default": 16 },
        "maxHeldFlows": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 256 },
        "denyCooldownSeconds": { "type": "number", "minimum": 0, "maximum": 3600, "default": 30 }
      }
    },
    "sentinelMismatch": {
      "enum": ["block", "log"],
      "default": "block",
      "description": "What to do when a sentinel appears anywhere other than the header a matching binding names. It is never swapped either way."
    },
    "allow": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/definitions/rule" }
    },
    "credentials": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/definitions/credential" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "host": {
      "type": "string",
      "description": "Lowercase ASCII hostname, '*.' + hostname for strict subdomains, or an IPv4/IPv6 literal (no brackets). Non-ASCII names must be given in punycode.",
      "maxLength": 253,
      "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$|^[0-9a-f:.]+$"
    },
    "method": { "type": "string", "pattern": "^([A-Z]{1,16}|\\*)$" },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/method" }
    },
    "path": {
      "type": "string",
      "description": "Glob over the decoded, canonical request path (no query). '*' matches within one segment, '**' matches across segments.",
      "pattern": "^/[A-Za-z0-9._~!\\$&'()*+,=:@/-]*$",
      "maxLength": 1024
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "schemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["https", "http"] }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "host": { "$ref": "#/definitions/host" },
        "schemes": { "$ref": "#/definitions/schemes", "default": ["https"] },
        "ports": { "$ref": "#/definitions/ports", "description": "Defaults to the scheme's default port." },
        "methods": { "$ref": "#/definitions/methods", "default": ["*"] },
        "path": { "$ref": "#/definitions/path", "default": "/**" }
      }
    },
    "inject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "fmt"],
      "properties": {
        "header": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$",
          "description": "The only header the real value is ever written to. Chosen by the host, never by the caller."
        },
        "fmt": {
          "type": "string",
          "maxLength": 256,
          "description": "Template. '{value}' is the real secret; '{base64:TEXT}' base64-encodes TEXT after substituting {value}. Example: 'Basic {base64:x-access-token:{value}}'."
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "path", "methods"],
      "properties": {
        "host": { "$ref": "#/definitions/host" },
        "path": { "$ref": "#/definitions/path" },
        "methods": { "$ref": "#/definitions/methods" },
        "ports": { "$ref": "#/definitions/ports" },
        "inject": { "$ref": "#/definitions/inject" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bind"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "bind": {
          "oneOf": [
            { "$ref": "#/definitions/binding" },
            { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/definitions/binding" } }
          ]
        },
        "inject": { "$ref": "#/definitions/inject" },
        "provider": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$", "description": "Extra provider backstop deny-list to apply (by name). Providers are also applied automatically by host." },
        "sentinelPrefix": { "type": "string", "pattern": "^[A-Za-z0-9_-]{0,16}$" }
      }
    }
  }
}
